{
  "status": "preview",
  "formula": "Hanzi count × 0.22 seconds + 0.4 seconds per sentence; NOT final audio timing",
  "replaceWith": "audio/narration.json when final narration is available",
  "duration": 264.88,
  "sentences": [
    {
      "id": "01",
      "zh": "这根形似小香肠的盲管，就是阑尾。",
      "start": 0,
      "end": 3.48
    },
    {
      "id": "02",
      "zh": "发起炎来，它可能染上红、黄、黑。",
      "start": 3.48,
      "end": 6.52
    },
    {
      "id": "03",
      "zh": "每一次颜色流转，都记录着组织的伤痕。",
      "start": 6.52,
      "end": 10.44
    },
    {
      "id": "04",
      "zh": "循着这抹色彩，我们走进炎症的现场。",
      "start": 10.44,
      "end": 14.14
    },
    {
      "id": "05",
      "zh": "病理学里的“变质”，不是食物变坏。",
      "start": 14.14,
      "end": 17.4
    },
    {
      "id": "06",
      "zh": "先听听身体发出的求救信号。",
      "start": 17.4,
      "end": 20.44
    },
    {
      "id": "07",
      "zh": "疼痛可能从肚脐周围，移向右下腹。",
      "start": 20.44,
      "end": 23.92
    },
    {
      "id": "08",
      "zh": "还可能恶心、发热，右下腹明显压痛。",
      "start": 23.92,
      "end": 27.4
    },
    {
      "id": "09",
      "zh": "疼痛若持续加重，别抱着侥幸硬扛。",
      "start": 27.4,
      "end": 30.88
    },
    {
      "id": "10",
      "zh": "相似的求救声，也可能来自其他腹部疾病。",
      "start": 30.88,
      "end": 35.02
    },
    {
      "id": "11",
      "zh": "有些人的信号，却并不典型。",
      "start": 35.02,
      "end": 37.84
    },
    {
      "id": "12",
      "zh": "医生先循着症状和体格检查寻找线索，",
      "start": 37.84,
      "end": 41.76
    },
    {
      "id": "13",
      "zh": "再参考化验，判断是否阑尾炎。",
      "start": 41.76,
      "end": 44.8
    },
    {
      "id": "14",
      "zh": "CT是重要的辅助确诊工具，",
      "start": 44.8,
      "end": 47.4
    },
    {
      "id": "15",
      "zh": "但并非人人都必须做CT。",
      "start": 47.4,
      "end": 49.78
    },
    {
      "id": "16",
      "zh": "汇总8项研究的荟萃分析显示，",
      "start": 49.78,
      "end": 52.82
    },
    {
      "id": "17",
      "zh": "增强螺旋CT敏感度95%、特异度94%。[1]",
      "start": 52.82,
      "end": 55.42
    },
    {
      "id": "18",
      "zh": "这束影像之光，能帮助发现病变，",
      "start": 55.42,
      "end": 58.68
    },
    {
      "id": "19",
      "zh": "却仍需结合临床，判断病情轻重。",
      "start": 58.68,
      "end": 61.94
    },
    {
      "id": "20",
      "zh": "单纯性→化脓性（蜂窝织炎性）→坏疽性",
      "start": 61.94,
      "end": 65.42
    },
    {
      "id": "21",
      "zh": "是最常见的典型演变，",
      "start": 65.42,
      "end": 67.8
    },
    {
      "id": "22",
      "zh": "但并不是每个患者都必经的固定流程。",
      "start": 67.8,
      "end": 71.72
    },
    {
      "id": "23",
      "zh": "第一幕红：单纯性阑尾炎，充血、轻度肿胀。",
      "start": 71.72,
      "end": 75.64
    },
    {
      "id": "24",
      "zh": "局部血管扩张，血流增多，染出这抹红。",
      "start": 75.64,
      "end": 79.34
    },
    {
      "id": "25",
      "zh": "血管里的液体和蛋白质渗出，",
      "start": 79.34,
      "end": 82.38
    },
    {
      "id": "26",
      "zh": "积在组织间隙，形成水肿。",
      "start": 82.38,
      "end": 84.98
    },
    {
      "id": "27",
      "zh": "巡逻的白细胞游出血管，挺进受损组织。",
      "start": 84.98,
      "end": 88.9
    },
    {
      "id": "28",
      "zh": "这是身体为抵御损伤，调动的防御。",
      "start": 88.9,
      "end": 92.38
    },
    {
      "id": "29",
      "zh": "然而战况一旦失控，也可能伤及自身组织。",
      "start": 92.38,
      "end": 96.52
    },
    {
      "id": "30",
      "zh": "液体、蛋白质和白细胞外出，叫渗出。",
      "start": 96.52,
      "end": 100.0
    },
    {
      "id": "31",
      "zh": "单纯性时，中性粒细胞主要驻守在",
      "start": 100.0,
      "end": 103.48
    },
    {
      "id": "32",
      "zh": "黏膜及黏膜下层，组织损伤相对较轻。",
      "start": 103.48,
      "end": 107.18
    },
    {
      "id": "33",
      "zh": "变质，就是细胞组织的变性、坏死。",
      "start": 107.18,
      "end": 110.44
    },
    {
      "id": "34",
      "zh": "此时，黏膜上皮已局部受损脱落。[2]",
      "start": 110.44,
      "end": 113.7
    },
    {
      "id": "35",
      "zh": "CT可见管径增粗、壁增厚，",
      "start": 113.7,
      "end": 116.08
    },
    {
      "id": "36",
      "zh": "周围脂肪轻度模糊，呼应早期的炎症。",
      "start": 116.08,
      "end": 119.78
    },
    {
      "id": "37",
      "zh": "第二幕黄：炎症的战线累及整层阑尾壁。",
      "start": 119.78,
      "end": 123.7
    },
    {
      "id": "38",
      "zh": "这是化脓性，也叫蜂窝织炎性阑尾炎。",
      "start": 123.7,
      "end": 127.4
    },
    {
      "id": "39",
      "zh": "中性粒细胞纷纷涌入，部分变性坏死。",
      "start": 127.4,
      "end": 131.1
    },
    {
      "id": "40",
      "zh": "脓液中，还混着组织碎屑与渗出的液体。",
      "start": 131.1,
      "end": 135.02
    },
    {
      "id": "41",
      "zh": "渗出愈明显，局部肿胀往往愈突出。",
      "start": 135.02,
      "end": 138.5
    },
    {
      "id": "42",
      "zh": "变性坏死的中性粒细胞，就是脓细胞。",
      "start": 138.5,
      "end": 142.2
    },
    {
      "id": "43",
      "zh": "渗出的纤维蛋白原凝成纤维素网。",
      "start": 142.2,
      "end": 145.68
    },
    {
      "id": "44",
      "zh": "网与脓细胞等交织，形成纤维脓性渗出物。",
      "start": 145.68,
      "end": 149.82
    },
    {
      "id": "45",
      "zh": "黄色并非只来自纤维素，更来自大量脓细胞。",
      "start": 149.82,
      "end": 154.18
    },
    {
      "id": "46",
      "zh": "浆膜面可见纤维素性脓性渗出（含脓细胞）。",
      "start": 154.18,
      "end": 158.32
    },
    {
      "id": "47",
      "zh": "CT常见壁增厚强化、周围渗出明显，",
      "start": 158.32,
      "end": 161.58
    },
    {
      "id": "48",
      "zh": "与管壁内外的炎症相互映照。",
      "start": 161.58,
      "end": 164.62
    },
    {
      "id": "49",
      "zh": "终局黑：腔内压力升高，危机步步逼近。",
      "start": 164.62,
      "end": 168.32
    },
    {
      "id": "50",
      "zh": "血管受压或形成血栓，阑尾壁陷入缺血。",
      "start": 168.32,
      "end": 172.24
    },
    {
      "id": "51",
      "zh": "血流受阻，组织坏死，还伴有出血。",
      "start": 172.24,
      "end": 175.5
    },
    {
      "id": "52",
      "zh": "坏死与血红蛋白分解产物，",
      "start": 175.5,
      "end": 178.32
    },
    {
      "id": "53",
      "zh": "让局部暗红，甚至发黑。",
      "start": 178.32,
      "end": 180.7
    },
    {
      "id": "54",
      "zh": "变质在这里走向重处：大片组织坏死。",
      "start": 180.7,
      "end": 184.4
    },
    {
      "id": "55",
      "zh": "它与渗出，共同写下急性期的病变。",
      "start": 184.4,
      "end": 187.88
    },
    {
      "id": "56",
      "zh": "这便是坏疽性阑尾炎。",
      "start": 187.88,
      "end": 190.26
    },
    {
      "id": "57",
      "zh": "脆弱的管壁可能穿孔，让感染扩散至腹腔。",
      "start": 190.26,
      "end": 194.4
    },
    {
      "id": "58",
      "zh": "CT若见壁强化缺损，要警惕坏死；",
      "start": 194.4,
      "end": 197.44
    },
    {
      "id": "59",
      "zh": "若见腔外气体、脓肿，更要警惕穿孔。[3]",
      "start": 197.44,
      "end": 200.92
    },
    {
      "id": "60",
      "zh": "读懂分型，是为了把握治疗的紧迫性。",
      "start": 200.92,
      "end": 204.62
    },
    {
      "id": "61",
      "zh": "最终分型，仍靠切除后的病理切片确认。",
      "start": 204.62,
      "end": 208.54
    },
    {
      "id": "62",
      "zh": "CT也帮助发现坏疽、穿孔、脓肿等并发症。[3][4]",
      "start": 208.54,
      "end": 212.24
    },
    {
      "id": "63",
      "zh": "蜂窝织炎性、坏疽性需手术切除。[5]",
      "start": 212.24,
      "end": 215.5
    },
    {
      "id": "64",
      "zh": "面对病变，治疗要结合患者的具体情况。",
      "start": 215.5,
      "end": 219.42
    },
    {
      "id": "65",
      "zh": "是否马上手术，由医生评估决定。",
      "start": 219.42,
      "end": 222.68
    },
    {
      "id": "66",
      "zh": "反复发作，可转为慢性阑尾炎。",
      "start": 222.68,
      "end": 225.72
    },
    {
      "id": "67",
      "zh": "急性期以变质、渗出为主，",
      "start": 225.72,
      "end": 228.32
    },
    {
      "id": "68",
      "zh": "转为慢性才出现增生。",
      "start": 228.32,
      "end": 230.7
    },
    {
      "id": "69",
      "zh": "镜下可见阑尾壁纤维组织增生、纤维化，",
      "start": 230.7,
      "end": 234.62
    },
    {
      "id": "70",
      "zh": "伴淋巴细胞、浆细胞等慢性炎细胞浸润。[2]",
      "start": 234.62,
      "end": 238.54
    },
    {
      "id": "71",
      "zh": "转入慢性，并不意味着从此风平浪静。",
      "start": 238.54,
      "end": 242.24
    },
    {
      "id": "72",
      "zh": "疼痛即便时轻时重，也应接受正规评估。",
      "start": 242.24,
      "end": 246.16
    },
    {
      "id": "73",
      "zh": "一旦确诊，通常建议症状缓解期择期切除；",
      "start": 246.16,
      "end": 250.3
    },
    {
      "id": "74",
      "zh": "若正处急性发作期，则视情况急诊手术。",
      "start": 250.3,
      "end": 254.22
    },
    {
      "id": "75",
      "zh": "红、黄、黑，是洞察微观病变的罗盘，",
      "start": 254.22,
      "end": 257.48
    },
    {
      "id": "76",
      "zh": "不是等待病情演进的时钟。别等病情加重，",
      "start": 257.48,
      "end": 261.62
    },
    {
      "id": "77",
      "zh": "持续右下腹痛、发热，请及时就诊。",
      "start": 261.62,
      "end": 264.88
    }
  ]
}
