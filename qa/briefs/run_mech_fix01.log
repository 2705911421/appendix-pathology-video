import { prepareMechVascular, drawVessel } from '../lib_ext/mech_vascular.js';
import { prepareCross, drawCrossSection } from '../lib_ext/mech_cross.js';
import { prepareTissue, drawTissueField, tissueAnchors } from '../lib_ext/mech_tissue.js';
import { prepare as prepareGross, drawAppendix, frameAt, toScreen, tubeRadius, swellAt } from '../lib_ext/mech_gross_appendix.js';

const smooth = x => { x = Math.max(0, Math.min(1, x)); return x * x * (3 - 2 * x); };
const mix = (a, b, p) => a + (b - a) * p;
const TAU = Math.PI * 2;

// thin leader + light-violet text, no box (same convention as S06)
function tag(c, lines, x, y, px, py, a = 1, { align = 'left', size = 33 } = {}) {
  if (a <= .01) return;
  c.save();
  c.globalAlpha = a;
  c.font = `500 ${size}px MixSans`;
  const arr = Array.isArray(lines) ? lines : [lines];
  const w = Math.max(...arr.map(s => c.measureText(s).width));
  const sx = align === 'right' ? x + w + 6 : x - 6;
  const sy = y - size * .28;
  const dir = px > sx ? 1 : -1;
  c.strokeStyle = '#AC98B7';
  c.lineWidth = 1.6;
  c.beginPath();
  c.moveTo(sx, sy);
  c.lineTo(sx + dir * 30, sy);
  c.lineTo(px, py);
  c.stroke();
  c.strokeStyle = 'rgba(244,239,230,.88)';
  c.lineWidth = 5;
  c.lineJoin = 'round';
  arr.forEach((s, i) => c.strokeText(s, x, y + i * (size + 7)));
  c.fillStyle = '#9276A6';
  arr.forEach((s, i) => c.fillText(s, x, y + i * (size + 7)));
  c.restore();
}

export default {
  prepare() {
    prepareMechVascular();
    prepareCross();
    prepareTissue();
    try { prepareGross(); } catch {}
  },
  draw(c, t, T) {
    c.setTransform(1, 0, 0, 1, 0, 0);
    c.fillStyle = '#F4EFE6';
    c.fillRect(0, 0, 1920, 1080);

    const s50 = T.at(50), s51 = T.at(51), s52 = T.at(52), s53 = T.at(53);

    // ── left column ─────────────────────────────────────────────────────────────────
    const t0 = smooth(t / .55);
    c.save();
    c.globalAlpha = t0;
    c.fillStyle = '#3A2438';
    c.font = '800 58px MixSans';
    c.fillText('终局黑', 85, 268);
    c.restore();

    const l49 = smooth((t - T.frac(49, .18)) / .5);
    const l50 = smooth((t - T.frac(50, .16)) / .45);
    const l51 = smooth((t - T.frac(51, .14)) / .45);
    const l52 = smooth((t - T.frac(52, .10)) / .45);
    const l53 = smooth((t - T.frac(53, .10)) / .45);
    c.save();
    c.fillStyle = '#2A2A35';
    c.font = '400 36px MixSans';
    c.globalAlpha = l49; c.fillText('腔内压力升高', 85, 372);
    c.globalAlpha = l50; c.fillText('受压／血栓 → 缺血', 85, 438);
    c.globalAlpha = l51; c.fillText('组织坏死、出血', 85, 504);
    c.globalAlpha = l52; c.fillText('血红蛋白分解产物', 85, 570);
    c.globalAlpha = l53; c.fillText('局部暗红、发黑', 85, 636);
    c.restore();

    // ── 49: cross-section, intraluminal pressure rising ─────────────────────────────
    const press = smooth((t - T.frac(49, .10)) / (T.frac(49, .82) - T.frac(49, .10)));
    const shrink = smooth((t - s50) / .85);
    const cx = mix(1180, 762, shrink), cy = mix(420, 462, shrink), cr = mix(268, 148, shrink);
    const crossA = 1 - smooth((t - s53) / .24);

    if (crossA > .01) {
      drawCrossSection(c, { x: cx, y: cy, R: cr, press, alpha: crossA });
      tag(c, '腔内压力', 1460, 148, cx + Math.cos(-.9) * (cr * .16), cy + Math.sin(-.9) * (cr * .16),
        smooth((t - T.frac(49, .34)) / .5) * crossA * (1 - smooth((t - s50) / .28)));
    }

    // locator for the wall detail (appears as the inset opens)
    const locA = smooth((t - s50 - .1) / .45) * crossA;
    const loc = [cx + Math.cos(-.55) * (cr * .84), cy + Math.sin(-.55) * (cr * .84)];
    if (locA > .01) {
      c.save();
      c.globalAlpha = locA * (1 - smooth((t - s50) / .3));
      c.strokeStyle = '#AC98B7';
      c.lineWidth = 1.6;
      c.beginPath(); c.arc(loc[0], loc[1], 24, 0, TAU); c.stroke();
      c.restore();
    }

    // ── inset window (50–52) ────────────────────────────────────────────────────────
    const open = smooth((t - s50 - .02) / .72);
    const wx = 1432, wy = 452, wr = 350;
    const tissueA = smooth((t - s51 - .04) / .32);
    const grossA = smooth((t - s53 - .20) / .42);
    const insetA = (1 - smooth((t - s53) / .24)) * open;
    const contentA = open;

    if (open > .01 && grossA < .99) {
      const r = wr * open;
      if (locA > .01) {
        c.save();
        c.globalAlpha = locA * insetA * contentA;
        c.strokeStyle = '#AC98B7';
        c.lineWidth = 1.6;
        c.beginPath();
        c.moveTo(loc[0] + 14, loc[1] - 20);
        c.lineTo(wx - r * .70, wy - r * .72);
        c.moveTo(loc[0] + 14, loc[1] + 20);
        c.lineTo(wx - r * .70, wy + r * .72);
        c.stroke();
        c.restore();
      }
      c.save();
      c.globalAlpha = insetA;
      c.beginPath(); c.arc(wx, wy, r, 0, TAU);
      c.fillStyle = '#F4EFE6'; c.fill();
      c.save();
      c.clip();

      // 50: two routes in the wall — external compression and thrombosis
      const mechA = 1 - tissueA;
      if (mechA > .01) {
        const sq = smooth((t - T.frac(50, .10)) / (T.frac(50, .62) - T.frac(50, .10)));
        const th = smooth((t - T.frac(50, .16)) / (T.frac(50, .66) - T.frac(50, .16)));
        const fl = (t % 10) / 10;
        c.save();
        c.globalAlpha = mechA * contentA;
        c.translate(wx, wy);

        c.fillStyle = '#F4E8E4';
        c.fillRect(-r, -r, r * 2, r * 2);

        // upper vessel: squeezed from outside. Chevrons stop at the waist.
        c.save();
        c.translate(0, -128);
        drawVessel(c, {
          L: 300, h: 48, wall: 11, squeeze: sq, squeezeX: -24, density: .72,
          flow: fl, flowAlpha: .85 * sq,
        });
        c.restore();
        // external squeeze arrows, no scale. Filled heads so they don't read as a Y.
        const sa = smooth((t - T.frac(50, .25)) / .5);
        if (sa > .01) {
          c.save();
          c.globalAlpha = sa;
          c.strokeStyle = 'rgba(90,48,64,.92)';
          c.fillStyle = 'rgba(90,48,64,.92)';
          c.lineWidth = 3.2;
          c.lineCap = 'round';
          for (const s of [-1, 1]) for (const dx of [-78, -24, 30]) {
            const tip = -128 + s * 86, tail = -128 + s * 148;
            c.beginPath();
            c.moveTo(dx, tail);
            c.lineTo(dx, tip + s * 16);
            c.stroke();
            c.beginPath();
            c.moveTo(dx - 11, tip + s * 18);
            c.lineTo(dx, tip);
            c.lineTo(dx + 11, tip + s * 18);
            c.closePath();
            c.fill();
          }
          c.restore();
        }

        // lower vessel: occlusive thrombus
        c.save();
        c.translate(0, 132);
        drawVessel(c, { L: 300, h: 48, wall: 11, thrombus: th, clotX: 36, flow: fl, flowAlpha: .9, density: .78 });
        c.restore();
        c.restore();
      }

      // 51–52: wall tissue dying, bleeding, then pigment
      if (tissueA > .01) {
        const n = smooth((t - T.frac(51, .16)) / (T.end(51) - T.frac(51, .16)));
        const b = smooth((t - T.frac(51, .34)) / (T.end(51) - T.frac(51, .34)));
        const g = smooth((t - T.frac(52, .12)) / (T.end(52) - T.frac(52, .12)));
        drawTissueField(c, { x: wx, y: wy, r, n, b, g, flow: (t % 9) / 9, alpha: tissueA * contentA });
      }
      c.restore();
      c.strokeStyle = '#C6B6C9';
      c.lineWidth = 1.6;
      c.beginPath(); c.arc(wx, wy, r, 0, TAU); c.stroke();
      c.restore();

      // labels
      const labA = insetA * contentA;
      tag(c, '受压', 1180, 176, wx - 30, wy - 128 - 42, labA * smooth((t - T.frac(50, .34)) / .4) * (1 - tissueA));
      tag(c, '血栓', 1594, 676, wx + 150, wy + 132, labA * smooth((t - T.frac(50, .5)) / .4) * (1 - tissueA));
      tag(c, '缺血', 1610, 228, wx + 120, wy - 150, labA * smooth((t - T.frac(50, .74)) / .3) * (1 - tissueA));
      tag(c, '坏死', 1810, 470, wx + 90, wy + 20, labA * smooth((t - T.frac(51, .38)) / .4) * tissueA);
      tag(c, '出血', 1688, 760, wx + tissueAnchors.bleed[0], wy + tissueAnchors.bleed[1], labA * smooth((t - T.frac(51, .62)) / .35) * tissueA);
      tag(c, ['血红蛋白', '分解产物'], 1560, 150, wx + tissueAnchors.pigment[0], wy + tissueAnchors.pigment[1], labA * smooth((t - T.frac(52, .3)) / .45) * (1 - grossA));
    }

    // ── 53: gross close-up, dark red → black ────────────────────────────────────────
    if (grossA > .01) {
      const grow = smooth((t - T.frac(53, .08)) / (T.end(53) - T.frac(53, .08)));
      const stage = mix(2.52, 3, grow);
      const sc = mix(1.96, 2.08, grow);
      const rot = .95;
      // Pin the black plaque in the right panel so the dark-red shaft and the tip both stay on screen.
      const f = frameAt(.8), w = tubeRadius(.8, swellAt(3)), lx = f.p[0] + f.nx * w * -.08, ly = f.p[1] + f.ny * w * -.08;
      const co = Math.cos(rot), si = Math.sin(rot);
      const tx = 1340, ty = 500;
      const pose = { x: tx - (lx * co - ly * si) * sc, y: ty - (lx * si + ly * co) * sc, sc, rot };
      c.save();
      c.globalAlpha = grossA;
      drawAppendix(c, stage, pose, { pit: false });
      c.restore();
      const swell = swellAt(stage);
      const fBlack = frameAt(.80);
      const pDark = toScreen(pose, [fBlack.p[0] + fBlack.nx * tubeRadius(.80, swell) * -.12, fBlack.p[1] + fBlack.ny * tubeRadius(.80, swell) * -.12]);
      tag(c, '发黑', 1628, 360, pDark[0], pDark[1], grossA * smooth((t - T.frac(53, .28)) / .35));
      // Distal red serosa, past the black plaques (those sit around s .75–.85) and off the mesoappendix.
      const fRed = frameAt(.895);
      const pRed = toScreen(pose, [fRed.p[0] + fRed.nx * tubeRadius(.895, swell) * -.2, fRed.p[1] + fRed.ny * tubeRadius(.895, swell) * -.2]);
      tag(c, '暗红', 1188, 800, pRed[0], pRed[1], grossA * smooth((t - T.frac(53, .42)) / .35));
    }
  },
};
// Lane mech: appendix cross-section for the intraluminal-pressure beat (S13, sentence 49).
// Paper watercolour, ink outline. The lumen distends as pressure rises while the wall and its
// intramural vessels are squeezed; short radial arrows are the only pressure cue (no scale).
import { bake, get } from '../lib/wash.js';
import { rng } from '../lib/motion.js';

const TAU = Math.PI * 2;
const speck = [];

export function prepareCross() {
  speck.length = 0;
  const r = rng(55201);
  for (let i = 0; i < 90; i++) speck.push({ a: r() * TAU, d: Math.sqrt(r()), s: .5 + r() * 1.4 });
  try { bake('mech.cross', (b, P) => {
    P.fill(b, P.blob(0, 0, 300, 38, .16, 551), '#C9455A', 38, .4, [.3, .4]);
    P.fill(b, P.blob(0, 0, 210, 30, .16, 552), '#8E3A3E', 30, .4, [.3, .4]);
  }, { seed: 551, scale: 1, hd: true, soft: true, grain: .24, edge: .42, bleed: .6 }); } catch {}
}

const wob = (a, k, p) => 1 + .016 * Math.sin(a * 5 + 1.2 + p) + .009 * Math.sin(a * 9 + .4);

function ring(c, cx, cy, ro, ri, wobA, wobB, p) {
  c.beginPath();
  for (let i = 0; i <= 96; i++) {
    const a = i / 96 * TAU, r = ro * wob(a, 0, p) * wobA;
    c.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r);
  }
  for (let i = 96; i >= 0; i--) {
    const a = i / 96 * TAU, r = ri * wob(a, 1, p) * wobB;
    c.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r);
  }
  c.closePath();
}

export function drawCrossSection(c, { x, y, R, press = 0, alpha = 1 }) {
  if (alpha <= .01) return;
  const p = press;
  // lumen distends; the wall layers thin while the outer serosal line stays put
  const rLum = R * (.285 + .065 * p);
  const rMuc = rLum + R * (.155 - .012 * p);
  const rSub = rMuc + R * (.165 - .004 * p);
  const rMus = rSub + R * (.285 - .050 * p);
  const rSer = R * (.995 + .005 * p);

  c.save();
  c.globalAlpha *= alpha;
  c.translate(x, y);

  // soft cast shadow on paper
  const sh = c.createRadialGradient(4, 8, R * .4, 4, 8, R * 1.06);
  sh.addColorStop(0, 'rgba(90,60,66,.10)');
  sh.addColorStop(1, 'rgba(90,60,66,0)');
  c.fillStyle = sh;
  c.beginPath(); c.arc(4, 8, R * 1.06, 0, TAU); c.fill();

  // serosa / subserosa
  ring(c, 0, 0, rSer, rMus, 1, 1, p);
  c.fillStyle = '#E9CFD2'; c.fill();
  c.strokeStyle = 'rgba(150,104,116,.55)'; c.lineWidth = 2; c.stroke();

  // muscularis — congested, watercolour mottling
  ring(c, 0, 0, rMus, rSub, 1, 1, p);
  const mg = c.createRadialGradient(-R * .3, -R * .35, R * .2, 0, 0, rMus);
  mg.addColorStop(0, '#C06A66');
  mg.addColorStop(.55, '#AE4F52');
  mg.addColorStop(1, '#8E3A42');
  c.fillStyle = mg; c.fill();
  c.save(); c.clip();
  const tex = get('mech.cross');
  if (tex) { c.globalAlpha *= .42; c.drawImage(tex, -rMus, -rMus, rMus * 2, rMus * 2); }
  c.restore();
  c.strokeStyle = 'rgba(110,52,60,.55)'; c.lineWidth = 2; c.stroke();

  // submucosa
  ring(c, 0, 0, rSub, rMuc, 1, 1, p);
  c.fillStyle = '#E7D2CC'; c.fill();
  c.strokeStyle = 'rgba(150,104,116,.42)'; c.lineWidth = 1.6; c.stroke();

  // mucosa — irregular folds
  c.beginPath();
  for (let i = 0; i <= 120; i++) {
    const a = i / 120 * TAU;
    const r = rMuc * (1 + .045 * Math.sin(a * 11 + .7 + p * 2) + .02 * Math.sin(a * 19));
    c.lineTo(Math.cos(a) * r, Math.sin(a) * r);
  }
  for (let i = 120; i >= 0; i--) {
    const a = i / 120 * TAU;
    const r = rLum * (1 + .035 * Math.sin(a * 9 + 1.5));
    c.lineTo(Math.cos(a) * r, Math.sin(a) * r);
  }
  c.closePath();
  c.fillStyle = '#C98390'; c.fill();
  c.strokeStyle = 'rgba(120,58,74,.45)'; c.lineWidth = 1.5; c.stroke();

  // lumen: murky residual content (yellowish, not a bright stain)
  c.beginPath();
  for (let i = 0; i <= 96; i++) {
    const a = i / 96 * TAU;
    const r = rLum * (1 + .035 * Math.sin(a * 9 + 1.5));
    c.lineTo(Math.cos(a) * r, Math.sin(a) * r);
  }
  c.closePath();
  c.fillStyle = '#D8C7A2'; c.fill();
  c.save(); c.clip();
  for (let i = 0; i < speck.length; i++) {
    const s = speck[i], a = s.a + p * .04;
    c.fillStyle = 'rgba(120,100,70,.30)';
    c.beginPath();
    c.arc(Math.cos(a) * s.d * rLum, Math.sin(a) * s.d * rLum, s.s, 0, TAU);
    c.fill();
  }
  c.restore();
  c.strokeStyle = 'rgba(130,102,66,.45)'; c.lineWidth = 1.4; c.stroke();

  // intramural vessels: five small sections in the muscularis, flattened where pressure squeezes
  const vs = [[-.55, .84, 13], [-.05, .87, 15], [.55, .8, 12], [1.55, .86, 14], [2.5, .85, 12], [3.6, .87, 13], [4.7, .86, 12]];
  vs.forEach(([a, k, rr], i) => {
    const squeeze = Math.max(0, Math.cos(a - .55)) ** 6;
    const rad = rSub + (rMus - rSub) * k;
    c.save();
    c.translate(Math.cos(a) * rad, Math.sin(a) * rad);
    c.rotate(a + Math.PI / 2);
    c.beginPath();
    c.ellipse(0, 0, rr * (1 + .25 * p), rr * (.62 - .42 * p * squeeze), 0, 0, TAU);
    c.fillStyle = `rgba(150,38,46,${.62 + .2 * p})`;
    c.fill();
    c.strokeStyle = 'rgba(92,24,34,.6)'; c.lineWidth = 1;
    c.stroke();
    c.restore();
  });

  // pressure arrows: short radial marks, no scale, only inside the lumen
  if (p > .02) {
    const N = 9;
    for (let i = 0; i < N; i++) {
      const a = -2.5 + i / (N - 1) * 4.6;
      const r0 = rLum * .18, r1 = rLum * (.62 + .2 * p), r2 = rLum * (.78 + .2 * p);
      const k = .5 + .5 * p;
      c.strokeStyle = `rgba(66,42,52,${.26 + .46 * k})`;
      c.lineWidth = 3.2;
      c.beginPath();
      c.moveTo(Math.cos(a) * r0, Math.sin(a) * r0);
      c.lineTo(Math.cos(a) * r1, Math.sin(a) * r1);
      c.stroke();
      const hw = .15;
      c.beginPath();
      c.moveTo(Math.cos(a - hw) * r2 * .86, Math.sin(a - hw) * r2 * .86);
      c.lineTo(Math.cos(a) * r2, Math.sin(a) * r2);
      c.lineTo(Math.cos(a + hw) * r2 * .86, Math.sin(a + hw) * r2 * .86);
      c.stroke();
    }
  }
  c.restore();
}
// Lane mech: appendiceal-wall field for ischemia → necrosis with hemorrhage (S13, 51–52).
// Not an H&E plate and not a sheet of epithelial polygons. Smooth-muscle ribbons lose
// their spindle nuclei next to an occluded mural vessel; red cells leak between the
// ghost fibers; brown-black mottles are haemoglobin breakdown, with no concentration
// and no clock. Anchors are local offsets from the field centre for the labels.
import { rng } from '../lib/motion.js';
import { bake, get } from '../lib/wash.js';
import { drawRBC, drawVessel } from './mech_vascular.js';

const TAU = Math.PI * 2;
const bands = [];
const bleeds = [];
const pigments = [];

export const tissueAnchors = { necro: [80, 70], bleed: [150, 130], pigment: [36, -10] };

export function prepareTissue() {
  bands.length = bleeds.length = pigments.length = 0;
  const R = rng(77021);
  try { bake('mech.tissue', (b, P) => {
    P.fill(b, P.blob(0, 0, 280, 48, .18, 771), '#E7C4CE', 36, .45, [.3, .4]);
    P.fill(b, P.blob(40, 30, 180, 36, .2, 772), '#C9A0A4', 28, .4, [.3, .4]);
    P.fill(b, P.blob(-80, 80, 140, 30, .2, 773), '#8E3A3E', 22, .35, [.3, .4]);
  }, { seed: 771, scale: 1, hd: true, soft: true, grain: .2, edge: .35, bleed: .55 }); } catch {}

  for (let i = 0; i < 8; i++) {
    const nuclei = [];
    for (let k = 0; k < 7; k++) {
      nuclei.push({
        x: -300 + k * 96 + (R() - .5) * 22,
        dy: (R() - .5) * 8,
        len: 16 + R() * 8,
        rot: (R() - .5) * .5,
      });
    }
    bands.push({
      y: -270 + i * 74 + (R() - .5) * 10,
      phase: R() * 6,
      amp: 7 + R() * 8,
      half: 15 + R() * 5,
      nuclei,
    });
  }

  // haemorrhage: confluent beside the occluded vessel, sparse farther into the wall
  for (let i = 0; i < 16; i++) {
    const near = i < 9;
    const x = near ? -70 + R() * 200 : 40 + R() * 240;
    const y = near ? -40 + R() * 250 : -180 + R() * 400;
    if (Math.hypot(x, y) > 300) continue;
    const n = 4 + Math.floor(R() * 4), list = [];
    for (let k = 0; k < n; k++) list.push({
      dx: (R() - .5) * 54,
      dy: (R() - .5) * 40,
      rx: 11 + R() * 5,
      rot: (R() - .5) * 1.4,
      seed: R() * 7,
      sat: .5 + R() * .45,
      view: R(),
    });
    bleeds.push({ x, y, list });
  }
  tissueAnchors.bleed[0] = bleeds[2] ? bleeds[2].x + 10 : 140;
  tissueAnchors.bleed[1] = bleeds[2] ? bleeds[2].y + 8 : 120;
  tissueAnchors.necro[0] = 96;
  tissueAnchors.necro[1] = 36;

  for (let i = 0; i < 9; i++) {
    const b = bleeds[i % Math.max(1, bleeds.length)] || { x: 40, y: 20 };
    pigments.push({
      x: b.x + (R() - .5) * 48,
      y: b.y + (R() - .5) * 36,
      r: 22 + R() * 20,
      seed: R() * 8,
      a: .7 + R() * .3,
    });
  }
  // A few mottles sit in the open muscle, not under the vessel, so the label has a target.
  pigments.push({ x: 78, y: -36, r: 38, seed: 3.1, a: .95 });
  pigments.push({ x: 150, y: 46, r: 34, seed: 4.2, a: .9 });
  pigments.push({ x: 28, y: 128, r: 30, seed: 5.4, a: .85 });
  tissueAnchors.pigment[0] = 78;
  tissueAnchors.pigment[1] = -36;
  tissueAnchors.necro[0] = 36;
  tissueAnchors.necro[1] = 78;
}

function bandY(f, x) {
  return f.y + Math.sin(x / 88 + f.phase) * f.amp + Math.sin(x / 34 + f.phase * 1.7) * 3;
}

// n necrosis, b haemorrhage, g pigment. All 0..1, driven by sentence progress.
export function drawTissueField(c, { x, y, r = 350, n = 0, b = 0, g = 0, alpha = 1 }) {
  if (alpha <= .01) return;
  c.save();
  c.globalAlpha *= alpha;
  c.translate(x, y);
  c.beginPath();
  c.arc(0, 0, r, 0, TAU);
  c.clip();

  c.fillStyle = '#F6EEEA';
  c.fillRect(-r, -r, r * 2, r * 2);
  const tex = get('mech.tissue');
  if (tex) {
    c.save();
    c.globalAlpha *= .34;
    c.drawImage(tex, -r, -r, r * 2, r * 2);
    c.restore();
  }

  // smooth-muscle ribbons. Nuclei drop out beside the blocked vessel first.
  for (const f of bands) {
    c.beginPath();
    const top = [], bot = [];
    for (let i = 0; i <= 26; i++) {
      const px = -340 + i * (680 / 26);
      const py = bandY(f, px);
      top.push([px, py - f.half]);
      bot.push([px, py + f.half]);
    }
    c.moveTo(top[0][0], top[0][1]);
    for (const p of top) c.lineTo(p[0], p[1]);
    for (let i = bot.length - 1; i >= 0; i--) c.lineTo(bot[i][0], bot[i][1]);
    c.closePath();
    // a ribbon is a mix: the left (near the vessel) dies, the right may still have nuclei
    const ribbon = c.createLinearGradient(-40, 0, 220, 0);
    const dead = Math.min(1, n * 1.2);
    ribbon.addColorStop(0, `rgba(${(210 + (142 - 210) * dead) | 0},${(176 + (132 - 176) * dead) | 0},${(182 + (134 - 182) * dead) | 0},${.55})`);
    ribbon.addColorStop(.45, `rgba(${(220 + (168 - 220) * dead) | 0},${(188 + (156 - 188) * dead) | 0},${(196 + (158 - 196) * dead) | 0},${.46})`);
    ribbon.addColorStop(1, 'rgba(228,198,206,.42)');
    c.fillStyle = ribbon;
    c.fill();

    for (const q of f.nuclei) {
      const py = bandY(f, q.x) + q.dy;
      // 1 beside the occluded vessel, 0 toward the far wall. Steep so the near zone is anuclear by mid-sentence.
      const local = Math.max(0, Math.min(1, 1 - (q.x + 40) / 240));
      const w = Math.min(1, n * 1.85 * (0.15 + 0.85 * local));
      if (w < .62) {
        c.save();
        c.translate(q.x, py);
        c.rotate(q.rot);
        c.fillStyle = `rgba(214, 176, 190, ${(1 - w) * .45})`;
        c.beginPath();
        c.ellipse(0, 0, q.len, 5.2, 0, 0, TAU);
        c.fill();
        c.fillStyle = `rgba(107, 74, 140, ${.78 * (1 - w / .62)})`;
        c.beginPath();
        c.ellipse(0, 0, q.len * .62, 2.5, 0, 0, TAU);
        c.fill();
        c.restore();
      } else {
        c.fillStyle = `rgba(90, 64, 96, ${.28 * w})`;
        for (let k = 0; k < 5; k++) {
          c.beginPath();
          c.arc(q.x + Math.sin(q.len + k * 1.7) * 8, py + Math.cos(k * 2.1) * 4, 1.15, 0, TAU);
          c.fill();
        }
      }
    }
  }

  if (n > .02) {
    const gr = c.createRadialGradient(10, 30, 12, 20, 40, 300);
    gr.addColorStop(0, `rgba(132, 118, 122, ${.5 * n})`);
    gr.addColorStop(.5, `rgba(158, 142, 144, ${.22 * n})`);
    gr.addColorStop(1, 'rgba(168, 150, 152, 0)');
    c.fillStyle = gr;
    c.beginPath();
    c.arc(0, 0, r, 0, TAU);
    c.fill();
    // ghost outline of the ribbons once nuclei are gone, so the field is not a blank wash
    c.strokeStyle = `rgba(120, 96, 104, ${.28 * n})`;
    c.lineWidth = 1.15;
    for (const f of bands) {
      c.beginPath();
      for (let i = 0; i <= 16; i++) {
        const px = -300 + i * (220 / 16);
        const py = bandY(f, px);
        i ? c.lineTo(px, py) : c.moveTo(px, py);
      }
      c.stroke();
    }
  }

  // occluded mural vessel running through the field. No flow glyphs here:
  // the backed-up discs and the plug are the block. Chevrons belong to sentence 50.
  c.save();
  c.translate(-150, 10);
  c.rotate(Math.PI / 2);
  drawVessel(c, {
    L: 330, h: 54, wall: 12, squeeze: 0, thrombus: 1, clotX: 70,
    flowAlpha: 0, showWallNuclei: true, showNeutrophils: true,
    density: .85, cellSize: .92,
  });
  c.restore();

  if (b > .01) {
    for (const s of bleeds) {
      const gr = c.createRadialGradient(s.x, s.y, 2, s.x, s.y, 46);
      gr.addColorStop(0, `rgba(150, 42, 52, ${.14 * b})`);
      gr.addColorStop(1, 'rgba(150, 42, 52, 0)');
      c.fillStyle = gr;
      c.beginPath();
      c.arc(s.x, s.y, 46, 0, TAU);
      c.fill();
    }
    for (const s of bleeds) {
      for (const q of s.list) {
        drawRBC(c, s.x + q.dx, s.y + q.dy, {
          rx: q.rx, rot: q.rot, alpha: Math.min(1, b * 1.25) * .95,
          flat: .95, seed: q.seed, sat: q.sat, view: q.view,
        });
      }
    }
  }

  // Pigment sits on top of the leaked red cells so the mottles stay readable.
  if (g > .01) {
    for (const p of pigments) {
      const rr = p.r * (.4 + .6 * g);
      const gr = c.createRadialGradient(p.x, p.y, 2, p.x, p.y, rr);
      const dark = Math.round(62 - 28 * g);
      gr.addColorStop(0, `rgba(${dark},${Math.round(dark * .38)},${Math.round(dark * .34)},${.92 * p.a * Math.min(1, g * 1.2)})`);
      gr.addColorStop(.42, `rgba(96, 40, 38, ${.55 * p.a * g})`);
      gr.addColorStop(1, 'rgba(120, 48, 44, 0)');
      c.fillStyle = gr;
      c.beginPath();
      c.arc(p.x, p.y, rr, 0, TAU);
      c.fill();
      c.fillStyle = `rgba(42, 22, 24, ${.5 * g * p.a})`;
      for (let k = 0; k < 5; k++) {
        c.beginPath();
        c.arc(
          p.x + Math.sin(p.seed + k * 2.2) * rr * .35,
          p.y + Math.cos(p.seed * 1.4 + k) * rr * .3,
          1.3 + (k % 2), 0, TAU,
        );
        c.fill();
      }
    }
  }

  c.restore();
}

