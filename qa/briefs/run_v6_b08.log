function safeZone() {
  const v = opt.safe === undefined || opt.safe === true ? 'auto' : String(opt.safe);
  if (v === 'none') return null;
  if (v === 'auto') return H > W ? { t: 0.12 * H, r: 0, b: 0.12 * H, l: 0 } : null;
