export function heAt(t, T) {
  const rw = win(t, T.frac(s(0), .25), T.frac(s(0), .8));           // rewind
  const up = win(t, T.frac(s(2), .05), T.frac(s(2), .9));            // escalate to full wall
  const detail = ease.inOutCubic(seg(t, T.at(s(0)), T.frac(s(0), .8)));
