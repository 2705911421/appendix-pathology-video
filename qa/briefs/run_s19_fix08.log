 if(pl){g.addColorStop(0,'#AC7099');g.addColorStop(.5,'#BC82A8');g.addColorStop(1,'#C99BB9');}
 else{g.addColorStop(0,'#C6A2C5');g.addColorStop(1,'#D6B8D0');}
 c.fillStyle=g;c.fill();
