 // Broad collagen bundles follow the submucosal and intermuscular arcs, with irregular gaps and bends.
 for(let i=0;i<520;i++){
  const a=-1.58+(R()-.5)*2.5,r=510+R()*330,p=point(a,r),len=12+R()*32,w=1+R()*3.5;
