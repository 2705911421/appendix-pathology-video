export const smooth=x=>{x=Math.max(0,Math.min(1,x));return x*x*(3-2*x);};
export function progress(t,T,id,a=0,b=1){return smooth((t-T.frac(id,a))/(T.frac(id,b)-T.frac(id,a)));}

