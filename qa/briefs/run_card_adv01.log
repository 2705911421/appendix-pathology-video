import {ink} from '../lib/ink.js';
const C={ink:'#2A2A35',red:'#D6453A',purple:'#A38AB5',skin:'#DBB8A2',blue:'#9AAEB0',coat:'#E5E2DB',pants:'#8D919E'};
const textures=new Map();
function rng(seed){return()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296;};}
export function prepare(){if(textures.size)return;for(const [i,color] of Object.values(C).entries()){const b=document.createElement('canvas');b.width=b.height=768;const c=b.getContext('2d'),r=rng(771+i);c.fillStyle=color;c.globalAlpha=.45;c.fillRect(0,0,768,768);for(let k=0;k<2300;k++){c.globalAlpha=.008+r()*.018;c.fillStyle=k%3?'#F4EFE6':color;c.beginPath();c.ellipse(r()*768,r()*768,10+r()*90,8+r()*55,r()*3,0,7);c.fill();}for(let k=0;k<35000;k++){c.globalAlpha=.025+r()*.065;c.fillStyle=r()>.5?'#FFFFFF':color;c.fillRect(r()*768,r()*768,.6+r()*2,.6+r()*2);}textures.set(color,b);}}
export function text(c,s,x,y,size=36,color=C.ink,weight=500){c.font=`${weight} ${size}px MixSans`;c.fillStyle=color;c.fillText(s,x,y);}
function path(c,key,d,color){const p=new Path2D(d);if(color){c.save();c.fillStyle=c.createPattern(textures.get(color),'repeat');c.fill(p);c.restore();}ink(c,'clin.'+key,'path',[d],{fill:'none',stroke:C.ink,strokeWidth:2.6,roughness:.9,bowing:.8,seed:23},{fill:false});}
function line(c,key,pts,color=C.ink,width=2.6){ink(c,'clin.'+key,'curve',[pts],{fill:'none',stroke:color,strokeWidth:width,seed:12},{fill:false});}
export function leader(c,s,x,y,px,py){text(c,s,x,y,30,C.purple);c.strokeStyle=C.purple;c.lineWidth=1.6;c.beginPath();c.moveTo(x+5,y+10);c.lineTo(x+65,y+10);c.lineTo(px,py);c.stroke();}
export function person(c,{x=1000,y=120,scale=1,doctor=false,side=false,face='neutral',arm='rest'}={}){c.save();c.translate(x,y);c.scale(scale,scale);
 const k=(doctor?'doc':'pat')+(side?'side':'front');
 // Adult proportions; local top 0, bottom 620. No identifying traits.
 path(c,k+'legs',side?'M -28 377 L 35 377 L 48 604 L 16 610 L 0 458 L -3 607 L -36 609 Z':'M -62 377 L 64 377 L 78 604 Q 53 618 21 607 L 0 449 L -20 607 Q -52 618 -77 604 Z',C.pants);
 path(c,k+'neck','M -23 112 L -23 149 Q 0 169 25 149 L 22 110 Z',C.skin);
 path(c,k+'body',side?'M -16 142 Q -44 157 -47 182 L -36 389 Q 6 403 48 388 L 40 186 Q 30 154 18 143 Z':'M -26 142 Q -67 145 -93 166 L -109 288 L -76 297 L -64 233 L -66 390 Q 0 409 67 390 L 63 233 L 77 297 L 111 286 L 94 168 Q 62 146 26 142 Q 0 164 -26 142 Z',doctor?C.coat:C.blue);
 if(doctor&&side){line(c,k+'lapelSide',[[18,146],[32,193],[19,225],[27,390]]);line(c,k+'pocketSide',[[20,259],[38,259],[38,292],[22,292]]);}else if(doctor){line(c,k+'lapel1',[[-24,145],[-44,198],[-18,224],[0,310]]);line(c,k+'lapel2',[[25,145],[44,198],[18,224],[0,310]]);line(c,k+'hem',[[0,310],[0,397]]);line(c,k+'pocket',[[23,259],[54,259],[52,297],[25,297]]);line(c,k+'steth',[[24,160],[31,193],[18,218],[-3,210],[-15,185],[-14,163]],'#6B4C9A',2);}
 path(c,k+'head',side?'M -37 31 Q -17 -3 17 10 Q 45 25 38 58 L 53 76 L 38 82 Q 38 112 19 124 L -12 118 Q -38 101 -39 72 Z':'M -43 38 Q -39 3 0 6 Q 39 5 43 39 L 39 83 Q 32 118 0 128 Q -31 118 -39 85 Z',C.skin);
 path(c,k+'hair',side?'M -39 65 Q -52 21 -22 5 Q 19 -12 38 20 L 40 49 Q 10 39 0 22 Q -26 46 -30 73 Z':'M -43 65 Q -55 18 -19 4 Q 23 -9 42 24 L 44 58 L 30 39 Q 2 42 -14 25 Q -23 42 -36 45 L -38 70 Z',C.pants);
 if(side){line(c,k+'eye',[[22,59],[29,59]]);line(c,k+'nose',[[31,65],[34,77],[40,77]]);}else{line(c,k+'eyeL'+face,[[-27,66],[-18,face==='pain'?62:65],[-10,66]]);line(c,k+'eyeR'+face,[[10,66],[18,face==='pain'?62:65],[27,66]]);line(c,k+'nose',[[0,68],[-3,86],[3,87]]);}
 line(c,k+'mouth'+face,[[-10,102],[0,face==='pain'?98:103],[12,102]]);
 if(side){path(c,k+'armSide','M -20 178 Q -38 202 -21 295 L -10 378 Q -7 398 8 392 L 16 372 L 5 292 L 10 190 Z',C.skin);}else if(arm==='exam'){path(c,k+'examarm','M -109 282 L -77 286 L -99 313 L -214 338 Q -242 346 -246 334 Q -245 322 -223 319 L -124 294 Z',C.skin);}else if(arm==='pain'){path(c,k+'painarm','M -108 282 L -79 282 L -68 321 L -15 331 Q 2 335 -5 346 Q -13 352 -30 347 L -91 343 Q -110 325 -108 282 Z',C.skin);}else{path(c,k+'armleft','M -109 282 L -77 286 L -81 365 Q -78 391 -92 394 Q -108 392 -108 371 Z',C.skin);}
 if(!side)path(c,k+'armright','M 78 285 L 110 282 L 113 365 Q 114 393 100 394 Q 85 394 85 368 Z',C.skin);
 // Hair and trousers use quiet, sparse hand hatching.
 c.save();c.globalAlpha=.25;for(let i=0;i<(side?0:7);i++)line(c,k+'hatch'+i,[[-64+i*3,450+i*13],[-39+i*3,433+i*13]],C.ink,1.1);c.restore();
 c.restore();}
export function pain(c,x,y,a=1){c.save();c.globalAlpha=a;const g=c.createRadialGradient(x,y,2,x,y,39);g.addColorStop(0,'#D6453A99');g.addColorStop(1,'#D6453A00');c.fillStyle=g;c.fillRect(x-40,y-40,80,80);c.strokeStyle=C.red;c.lineWidth=2;c.beginPath();c.arc(x,y,11,0,7);c.stroke();c.restore();}
export function abdomen(c,x,y,s=1,migrate=1,ambiguous=false){c.save();c.translate(x,y);c.scale(s,s);path(c,'abdomen','M -123 -184 Q -91 -204 -65 -212 Q 0 -177 65 -212 Q 97 -201 123 -184 L 100 -55 Q 93 21 118 144 Q 76 198 0 208 Q -76 198 -118 144 Q -93 21 -100 -55 Z',C.skin);line(c,'abnavel',[[-4,-3],[0,2],[4,-3]]);line(c,'abgroinL',[[-117,143],[-58,172],[-27,193]],C.purple,1.4);line(c,'abgroinR',[[117,143],[58,172],[27,193]],C.purple,1.4);
 if(ambiguous==='atypical'){}else if(ambiguous){for(const [ax,ay] of [[-45,65],[38,23],[0,-65]])pain(c,ax,ay,.17);}else pain(c,-65*migrate,98*migrate);c.restore();}
export function thermometer(c,x,y){c.save();c.translate(x,y);path(c,'thermo','M -12 35 L -12 -65 Q -12 -82 0 -82 Q 12 -82 12 -65 L 12 35 A 25 25 0 1 1 -12 35 Z',C.coat);line(c,'thermoline',[[0,-38],[0,49]],C.red,6);c.restore();}
export function hospital(c,x,y,s=1){c.save();c.translate(x,y);c.scale(s,s);path(c,'hospital','M -91 64 L -91 -62 L 91 -62 L 91 64 L 23 64 L 23 10 L -23 10 L -23 64 Z',C.coat);line(c,'hc1',[[-22,-26],[22,-26]],C.red,5);line(c,'hc2',[[0,-48],[0,-4]],C.red,5);c.restore();}
export function arrow(c,x,y,x2,y2,a=1){c.save();c.globalAlpha=a;c.strokeStyle=C.purple;c.lineWidth=2;c.beginPath();c.moveTo(x,y);c.lineTo(x2,y2);const r=Math.atan2(y2-y,x2-x);c.moveTo(x2-13*Math.cos(r-.5),y2-13*Math.sin(r-.5));c.lineTo(x2,y2);c.lineTo(x2-13*Math.cos(r+.5),y2-13*Math.sin(r+.5));c.stroke();c.restore();}
export function lab(c,x,y,s=1){c.save();c.translate(x,y);c.scale(s,s);path(c,'labpaper','M -110 -140 L 110 -140 L 110 140 L -110 140 Z',C.coat);text(c,'化验',-72,-84,34);for(let i=0;i<3;i++){line(c,'labtick'+i,[[-72,-30+i*51],[-60,-18+i*51],[-39,-43+i*51]],C.purple,2);line(c,'labline'+i,[[-15,-28+i*51],[70,-28+i*51]],C.purple,1.6);}c.restore();}
export function specimen(c,x,y,s=1){c.save();c.translate(x,y);c.scale(s,s);path(c,'jar','M -80 -90 L 80 -90 L 76 92 Q 0 118 -76 92 Z',C.coat);path(c,'jarcap','M -86 -109 L 86 -109 L 86 -87 L -86 -87 Z',C.blue);path(c,'appendix','M -30 -33 Q 33 -26 28 21 Q 24 61 -4 69 Q -27 72 -18 57 Q 4 35 -2 15 Q -7 -3 -33 -7 Z',C.skin);c.restore();}
export function slide(c,x,y,s=1){c.save();c.translate(x,y);c.scale(s,s);path(c,'slide','M -112 -64 L 112 -64 L 112 64 L -112 64 Z',C.coat);path(c,'tissue','M -42 -29 Q -2 -52 41 -21 L 31 26 Q 2 49 -39 18 Z','#DBB8A2');for(let i=0;i<20;i++){const ax=-28+(i*29)%57,ay=-20+(i*17)%44;c.fillStyle='#6B4C9A';c.beginPath();c.ellipse(ax,ay,2,3,.3,0,7);c.fill();}c.restore();}
export function scalpel(c,x,y,s=1){c.save();c.translate(x,y);c.scale(s,s);path(c,'scalpel','M -65 32 L 44 -43 L 67 -38 Q 62 -10 38 -5 L -54 45 Z',C.pants);c.restore();}
