}
function drawPinned(ctx, key, x, y, size, { alpha = 1, blend = 'multiply' } = {}) {
  const img = PIX.get(key); if (!img || alpha <= 0.001) return;
  ctx.save();
  ctx.globalAlpha *= alpha;
  ctx.globalCompositeOperation = blend;
