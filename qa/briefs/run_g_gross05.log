  if (!img || alpha <= 0.002) return;
  ctx.save();
  ctx.globalAlpha *= alpha;
  ctx.globalCompositeOperation = blend;
  ctx.translate(x, y); ctx.rotate(rot);
  ctx.drawImage(img, -sx / 2, -sy / 2, sx, sy);
  ctx.restore();
