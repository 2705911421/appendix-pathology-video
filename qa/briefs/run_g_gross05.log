// ── mesentery ────────────────────────────────────────────────────────────────────────────
function paintMesoBase(ctx, swell) {
  const loop = mesoLoop(swell);
  ctx.fillStyle = '#E9C778';
  path(ctx, loop); ctx.fill();
  // One smooth gradient across the hang (wall → free edge); the old 28 strips left seams.
  const a = mesoPt(0.36, swell, 2), b = mesoPt(0.3, swell, 112);
  const g = ctx.createLinearGradient(a[0], a[1], b[0], b[1]);
  g.addColorStop(0, '#C08C3C');
  g.addColorStop(0.14, '#D5A64E');
  g.addColorStop(0.44, '#EAC97D');
  g.addColorStop(0.74, '#F2D997');
  g.addColorStop(0.9, '#EACE86');
  g.addColorStop(1, '#D8AE57');
  ctx.fillStyle = g;
  path(ctx, loop); ctx.fill();
  // Pigment blooms over the flat fill.
  drawPinned(ctx, 'g.fat', 0, 20, 980, { alpha: .30, blend: 'multiply' });
  drawPinned(ctx, 'g.fat', -60, -10, 720, { alpha: .14, blend: 'multiply' });
}
// Fat cells: soft overlapping lobule sprites over the wash. No closed outlines — only the
// broken golden crescent baked into each sprite keeps the clumps legible.
function paintFatCells(ctx, swell, topOnly = false) {
  LOBULES.forEach(L => {
    if (!!L.top !== topOnly) return;
    const c = lobuleCenter(L, swell);
    const f = frameAt(L.s);
    const ang = Math.atan2(f.ty, f.tx) + L.rot;
    const r = L.r * 3.0;
    const a = L.alpha * (topOnly ? .88 : .92);
    drawSprite(ctx, FAT_SPRITES[L.tone], c[0], c[1], r, r * 0.9, ang, a);
    // Second offset lobe: the clump is not a round coin.
    const ox = f.tx * L.r * .42 + f.nx * L.r * .18;
    const oy = f.ty * L.r * .42 + f.ny * L.r * .18;
    drawSprite(ctx, FAT_SPRITES[(L.tone + 2) % FAT_SPRITES.length], c[0] + ox, c[1] + oy, r * .62, r * .56, ang + 1.25, a * .68);
  });
}
function paintMesoTint(ctx, swell, cong) {
  if (cong <= 0.02) return;
  const a = mesoPt(0.28, swell, 0), b = mesoPt(0.28, swell, 120);
  const g = ctx.createLinearGradient(a[0], a[1], b[0], b[1]);
  g.addColorStop(0, `rgba(190, 44, 40, ${.32 * cong})`);
  g.addColorStop(.45, `rgba(202, 74, 52, ${.16 * cong})`);
  g.addColorStop(1, 'rgba(210, 140, 70, 0)');
  ctx.fillStyle = g;
  path(ctx, mesoLoop(swell)); ctx.fill();
}
function paintVessels(ctx, swell, cong) {
  const artCol = mix3([126, 52, 50], [198, 44, 40], cong);
  const veinCol = mix3([86, 46, 54], [140, 42, 56], cong);
  const halo = mix3([180, 96, 88], [230, 96, 84], cong);
  const kW = 1 + 0.45 * cong;
  const trunkPts = vesselPts(VESSEL.trunk, swell);
  const veinPts = vesselPts(VESSEL.vein, swell);
  // Soft flush beneath the vessels.
  strokeTapered(ctx, trunkPts, 8 * kW, 5 * kW, halo, .09 * (.3 + cong));
  VESSEL.branches.forEach(b => strokeTapered(ctx, vesselPts(b, swell), 6 * kW, 3 * kW, halo, .08 * (.3 + cong)));
  // Vein sits deeper and slightly bluer.
  strokeTapered(ctx, veinPts, 1.5 * kW, 1.0 * kW, veinCol, .68);
  // Artery trunk + branches, tapering into the wall.
  strokeTapered(ctx, trunkPts, 2.2 * kW, 1.3 * kW, artCol, .86);
  VESSEL.branches.forEach((b, i) => {
    const pts = vesselPts(b, swell);
    strokeTapered(ctx, pts, 1.45 * kW, .55, artCol, .78);
    const tw = vesselPts(VESSEL.twigs[i], swell);
    strokeTapered(ctx, tw, .8 * kW, .38, artCol, .48);
  });
  VESSEL.arcades.forEach((b,i) => strokeTapered(ctx,vesselPts(b,swell),(.9-i*.08)*kW,.45,artCol,.48));
  // Fine caps near the serosa, more visible when congested.
  const R = rng(77021);
  for (let i = 0; i < 13; i++) {
    const s = 0.05 + R() * 0.7;
    const h = mesoHang(s);
    if (h < 10) continue;
    const p0 = mesoPt(s, swell, h * (0.04 + R() * 0.12));
    const p1 = mesoPt(s + 0.02 + R() * 0.02, swell, h * (0.10 + R() * 0.16));
    strokeTapered(ctx, [p0, p1], .8, .45, artCol, .30 + .35 * cong);
  }
}
function drawMesoInk(ctx, swell, px) {
  const edge = mesoFreeEdge(swell);
  inkStroke(ctx, 'g.mesoE', 'curve', [edge], { strokeWidth: 1.2 * px, roughness: .85, bowing: .46, seed: 61 }, 0.30);
  const cap = [mesoPt(0, swell, 0), mesoPt(0, swell, mesoHang(0))];
  inkStroke(ctx, 'g.mesoCap', 'linearPath', [cap], { strokeWidth: 1.1 * px, roughness: .85, bowing: .3, seed: 62 }, 0.24);
  // Fat-lobule septa: short faint creases, not a wireframe.
  const R = rng(4409);
  for (let i = 0; i < 28; i++) {
    const s = 0.08 + R() * 0.66;
    const h = mesoHang(s);
    if (h < 26) continue;
    const hf = 0.22 + R() * 0.62;
    const c = mesoPt(s, swell, h * hf);
    const f = frameAt(s);
    const len = 7 + R() * 11, ang = (R() - .5) * 1.5;
    const dx = Math.cos(ang) * len, dy = Math.sin(ang) * len;
    inkStroke(ctx, 'g.crease' + i, 'curve', [[
      [c[0] - f.tx * dx - f.nx * dy, c[1] - f.ty * dx - f.ny * dy],
      [c[0], c[1]],
      [c[0] + f.tx * dx + f.nx * dy, c[1] + f.ty * dx + f.ny * dy],
    ]], { strokeWidth: .7 * px, stroke: 'rgba(150, 104, 42, .55)', roughness: .62, bowing: .25, seed: 190 + i }, 0.20);
  }
}

// ── cylinder ────────────────────────────────────────────────────────────────────────────
// t = 0 on the mesenteric (shadow) wall, t = 1 on the lit serosa. Opaque, so overlaps do not darken.
function crossColor(look, t) {
  const sh = look.shadow, base = look.base, gl = look.gloss;
  const u = Math.max(0, Math.min(1, t));
  const stops = [0, 0.16, 0.34, 0.52, 0.74, 0.9, 1];
  const cols = [
    mix3(sh, base, 0.16),
    mix3(sh, base, 0.42),
    mix3(sh, base, 0.76),
    base,
    mix3(base, gl, 0.30),
    mix3(base, gl, 0.35),
    mix3(base, gl, 0.14),
  ];
  let i = 0;
  while (i < stops.length - 2 && u > stops[i + 1]) i++;
  const span = stops[i + 1] - stops[i] || 1;
  return mix3(cols[i], cols[i + 1], (u - stops[i]) / span);
}
function quad(ctx, a, b, c, d) {
  ctx.beginPath();
  ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]); ctx.lineTo(c[0], c[1]); ctx.lineTo(d[0], d[1]);
  ctx.closePath(); ctx.fill();
}

function paintCylinder(ctx, swell, look, dent) {
  const outline = tubeOutline(swell, dent);
  ctx.save();
  path(ctx, outline); ctx.clip();
  ctx.fillStyle = css(look.base);
  path(ctx, outline); ctx.fill();

  const N = 32;
  for (let i = 0; i < N; i++) {
    const step = CAP_S / N;
    const s0 = step * i;
    const s1 = Math.min(CAP_S, s0 + step * 1.22);
    const f0 = frameAt(s0), f1 = frameAt(s1);
    const wS0 = tubeRadius(s0, swell), wS1 = tubeRadius(s1, swell);
    const wL0 = litRadius(s0, swell, dent), wL1 = litRadius(s1, swell, dent);
    const sh = addN(f0, wS0), li = addN(f0, -wL0);
    const g = ctx.createLinearGradient(sh[0], sh[1], li[0], li[1]);
    for (let k = 0; k <= 8; k++) g.addColorStop(k / 8, css(crossColor(look, k / 8)));
    ctx.fillStyle = g;
    quad(ctx,
      addN(f0, wS0), addN(f1, wS1),
      addN(f1, -wL1), addN(f0, -wL0));
  }
  paintCap(ctx, swell, look);
  ctx.restore();
  return outline;
}

// Blind end shares the shaft's continuous cross-wall gradient, without strip seams.
function paintCap(ctx, swell, look) {
import {initBaker,bake} from './lib/wash.js';
import {bakeHE} from './lib/he.js';
import s08 from './chapters/s08.js';
import {forScene} from './timeline.js';
const name=new URLSearchParams(location.search).get('scene')||'s08';
if(!['s08','s10','gross_test'].includes(name))throw Error('Unknown scene '+name);
const scene=name==='s08'?s08:name==='s10'?(await import('./chapters/s10.js')).default:(await import('./chapters/gross_test.js')).default;
const clock=name==='s08'?{duration:T.end(34),T}:name==='s10'?forScene(37,42):{duration:5,T:null};
import {T} from './timeline.js';
const c=document.getElementById('c');c.width=1920;c.height=1080;const ctx=c.getContext('2d');
await document.fonts.load('500 32px MixSans');await document.fonts.load('700 40px MixSans');await document.fonts.load('800 52px MixSans');
await initBaker();
if(name!=='gross_test')bakeHE((k,r,o)=>bake(k,r,{...o,hd:true,soft:true,grain:.12,edge:.3,bleed:.5}));
scene.prepare();window.DUR=clock.duration;window.render=t=>scene.draw(ctx,t,clock.T);window.READY=true;
#!/usr/bin/env node
// Frame-accurate renderer for pages that expose the render(t) contract:
//   window.DUR = 15;              // seconds (optional if --duration is given)
//   window.render = (t) => {...}; // draw the frame at t seconds; deterministic; may return a Promise
//   window.READY = true;          // set once fonts / images / models are loaded
// Optional: window.RENDER_CONTEXT = true lets render(t, { frameTime, fps }) keep
// discrete copy/cuts on the output frame while motion uses sub-sample time t.
//
// Video
//   node render.mjs <project> [--out out/video.mp4] [--size 1920x1080] [--fps 30] [--workers 3]
//                   [--start 0] [--duration D] [--subframes 1] [--shutter 0.5] [--dpr 1]
//                   [--audio audio/music.wav] [--grain 0] [--crf 16] [--png] [--q "k=v&k2=v2"]
// Stills (review frames, PNG) and contact sheet
//   node render.mjs <project> --still 0.5,2,7.25 [--out qa/stills] [--sheet]
//   node render.mjs <project> --range 0:15:1 [--out qa/stills] [--sheet]
// Poster frame (step 7)
//   node render.mjs <project> --poster 14.5 [--out out/poster.png]
// Style-frame directions (step 3): one key frame per ?dir=<name>, side by side with labels
//   node render.mjs <project> --directions a,b,c --at 14.5,2,0 [--out qa/directions.png] [--dir-param dir]
//   (--at: one time per direction, or one time for all; singles go next to the sheet in qa/directions/)
// Determinism check (same t rendered in different orders must be pixel-identical)
//   node render.mjs <project> --determinism
// Text framing (review material, never pass/fail): text cut by the frame edge, two different strings on top of each
// other, text in the platform safe zone, text too small for a phone. Canvas 2D and DOM/SVG text; issues that last ≥ 0.3 s.
//   node render.mjs <project> --text-check [--every 0.2] [--safe auto|none|T,R,B,L] [--out qa/text]
//   (--safe: fractions of the frame (0.12) or pixels; auto = 12 % top and bottom on vertical frames, none on landscape)
//
// --subframes N blends N samples per frame (motion blur; render time × N). --shutter 0.5 = 180°.
// --dpr 2 supersamples (renders 2× and downsizes with lanczos): crisper hairlines / 3D edges, ~3× slower.
// --grain N adds temporal film grain in ffmpeg (keeps page frames compressible). 0 = none.
import fs from 'node:fs';
import path from 'node:path';
import { spawn, execFileSync } from 'node:child_process';
import { loadChromium, launch, serve, resolveTarget, openPage, warnSoftwareGL, parseSize, args, die } from './lib/browser.mjs';
import { textHook } from './lib/text-hook.mjs';

// Anything that must be undone on failure or interruption (ffmpeg children, temp dirs, output lock).
const cleanups = [];
const runCleanups = () => { while (cleanups.length) { try { cleanups.pop()(); } catch {} } };
const fail = msg => { console.error(msg); runCleanups(); process.exit(1); };
process.on('exit', runCleanups);
for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) process.on(sig, () => fail(`interrupted (${sig}); partial output removed`));
process.on('unhandledRejection', e => fail(`render failed: ${String(e?.message || e).split('\n')[0]}`));

const { pos, opt } = args(process.argv.slice(2));
const target = resolveTarget(pos[0]);
const { w: W, h: H } = parseSize(opt.size);
const FPS = +(opt.fps || 30);
const DPR = +(opt.dpr || 1);
if (!(FPS > 0 && FPS <= 240)) die(`bad --fps ${opt.fps}`);
if (!(DPR >= 1 && DPR <= 4)) die(`bad --dpr ${opt.dpr} (1–4)`);
const QUERY = typeof opt.q === 'string' ? opt.q : '';
const fmt = opt.png ? 'png' : 'jpeg';

const chromium = await loadChromium(target.root);
const { server, port } = await serve(target.root);
const browser = await launch(chromium);
const open = (query = QUERY, init = null) => openPage(browser, { port, rel: target.rel, w: W, h: H, dpr: DPR, query, init });
const finish = async code => { await browser.close().catch(() => {}); server.close(); process.exit(code); };
cleanups.push(() => server.close());

async function shoot(page, t, type = fmt, frameTime = t) {
  await page.evaluate(({ t, frameTime, fps }) => window.RENDER_CONTEXT === true
    ? window.render(t, { frameTime, fps })
    : window.render(t), { t, frameTime, fps: FPS });
  return await page.screenshot({ type, ...(type === 'jpeg' ? { quality: 95 } : {}), clip: { x: 0, y: 0, width: W, height: H } });
}

if (opt.poster !== undefined) await poster();
else if (opt.directions !== undefined) await directions();
