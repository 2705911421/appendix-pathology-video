// ── mesentery fat clumps (deterministic geometry in s / height-fraction space) ─────────────
const FAT_TONES = ['#EFD28C', '#E6C274', '#DDAA5C', '#F4DD9C', '#D2A858'];
const LOBULES = (() => {
