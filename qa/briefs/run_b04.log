import {ink} from './ink.js';
import {rng} from './motion.js';
import {chromatin,detailedNeutrophil,fibrinMesh,tissueTexture} from './he_detail.js';
import {drawVessels} from './he_guide.js';
import {pigment,stain} from './watercolor.js';
const TAU=Math.PI*2;
export const RADII={lumen:390,mucosa:540,mm:552,submucosa:805,circular:990,longitudinal:1105,serosa:1140};
const wave=a=>12*Math.sin(a*7)+7*Math.sin(a*13+.6);
export const polar=(a,r)=>[Math.sin(a)*(r+wave(a)), -Math.cos(a)*(r+wave(a))];
const R=rng(82024),crypts=[],lymph=[],neuts=[],muscle=[],follicles=[];
for(let i=0;i<56;i++)crypts.push({a:i/56*TAU+(R()-.5)*.025,r:435+R()*28,h:37+R()*26,w:10+R()*7,tilt:(R()-.5)*.45});
for(let i=0;i<13;i++)follicles.push({a:i/13*TAU+.08,r:665+R()*44,rx:75+R()*20,ry:73+R()*24});
for(let i=0;i<6200;i++)lymph.push({a:R()*TAU,r:398+R()*400,sz:1.9+R()*1.2,plasma:i%9===0});
// Separated cells, deterministically spaced; high power resolves individual lobes.
for(let row=0;row<15;row++){const r=410+row*25,n=Math.floor(TAU*r/34);for(let j=0;j<n;j++){const u=R();neuts.push({a:j/n*TAU+(R()-.5)*.012,r:r+(R()-.5)*7,lobes:u<.15?2:u<.6?3:u<.9?4:5,rot:R()*TAU,sz:.92});}}
for(let i=0;i<5;i++)neuts.push({a:(i-2)*.13,r:840+i*45,lobes:3,rot:R()*TAU,sz:.92,muscle:true});
for(let i=0;i<3000;i++)muscle.push({a:R()*TAU,r:810+R()*290,l:4+R()*5});
export async function bakeAcute(){for(const [key,col,seed] of [['mucosa','#D98BA8',801],['sub','#EBC3D0',802],['muscle','#D98BA8',803],['serosa','#EBC3D0',804]])pigment('acute.'+key,col,seed);}
function ring(c,r){const p=new Path2D();for(let i=0;i<=360;i++){const a=i/360*TAU,[x,y]=polar(a,r);i?p.lineTo(x,y):p.moveTo(x,y);}p.closePath();return p;}
function oval(c,x,y,rx,ry,col,a=0){c.beginPath();c.ellipse(x,y,rx,ry,a,0,TAU);c.fillStyle=col;c.fill();}
function nuc(c,x,y,rx,ry,a=0){oval(c,x,y,rx,ry,'#6B4C9A',a);chromatin(c,x,y,rx,ry,a);}
function local(c,a,r,fn){const p=polar(a,r);c.save();c.translate(...p);c.rotate(a);fn();c.restore();}
export function plasma(c,x,y){oval(c,x,y,6.5,8,'#EBC3D0');oval(c,x+1,y-2,2.7,3,'#F6EEF0');oval(c,x-1.8,y+3,3.5,3.7,'#6B4C9A');for(let j=0;j<7;j++){const a=j/7*TAU;oval(c,x-1.8+Math.cos(a)*2.4,y+3+Math.sin(a)*2.5,.85,.9,'#3F2A66');}}
const vesselSites=[[-.12,670,34],[.21,740,29],[.04,1120,16]];
export function drawAcute(c,{mode='simple',zoom=.35,focus={x:0,y:0}}={}){
 let visibleNeutrophils=0;
 const visible=(x,y,margin=110)=>Math.hypot(x-focus.x,y-focus.y)<460/zoom+margin;
 c.fillStyle='#F6EEF0';c.fillRect(-1700,-1700,3400,3400);
 // Ordered rings preserve one physical section from overview through cellular inspection.
 for(const [r,key] of [[1140,'serosa'],[1105,'muscle'],[805,'sub'],[552,'muscle'],[540,'mucosa']]){c.save();c.clip(ring(c,r));c.fillStyle=key==='muscle'?'#EBC3D0':'#F6EEF0';c.fillRect(-1200,-1200,2400,2400);for(let i=0;i<12;i++){const a=i/12*TAU;stain(c,'acute.'+key,...polar(a,r-65),900,.48);}c.restore();}
 c.fillStyle='#F6EEF0';c.fill(ring(c,390));
 // Muscularis mucosae: explicit pink band below crypt bases, clear of cell fields.
 c.save();const mmBand=ring(c,552);mmBand.addPath(ring(c,540));c.fillStyle='#D98BA8';c.fill(mmBand,'evenodd');c.restore();
 for(const r of [540,552,805,990,1105,1140]){c.strokeStyle=r===990?'#B97898':'rgba(156,99,136,.5)';c.lineWidth=r===990?1.4:.8;c.stroke(ring(c,r));}
 for(const f of follicles){local(c,f.a,f.r,()=>{oval(c,0,0,f.rx,f.ry,'#D6C5DF');oval(c,-5,-4,f.rx*.57,f.ry*.55,'#EEE2EC',.1);const F=rng(Math.floor(f.a*1000)+23);for(let j=0;j<280;j++){const a=F()*TAU,r=Math.sqrt(F()),edge=1+.07*Math.sin(a*5);const x=Math.cos(a)*f.rx*r*edge,y=Math.sin(a)*f.ry*r*edge;if(r<.56&&F()<.78){if(F()<.3)nuc(c,x,y,3.6,4);continue;}nuc(c,x,y,2.6,3.1);} });}
 for(const l of lymph){const [x,y]=polar(l.a,l.r);if(!visible(x,y))continue;if(l.r>=540&&l.r<=552)continue;if(crypts.some(g=>{const da=Math.atan2(Math.sin(l.a-g.a),Math.cos(l.a-g.a));return (da*l.r/g.w)**2+((l.r-g.r)/g.h)**2<1;}))continue;if(l.r>550&&follicles.some(f=>{const da=Math.atan2(Math.sin(f.a-l.a),Math.cos(f.a-l.a));return (da*l.r/f.rx)**2+((l.r-f.r)/f.ry)**2<1.15;}))continue;if(l.plasma&&zoom>.6)plasma(c,x,y);else oval(c,x,y,l.sz,l.sz*1.13,'#6B4C9A');}
 for(const g of crypts){if((mode==='simple'||mode==='suppurative')&&Math.abs(g.a)<.085)continue;local(c,g.a,g.r,()=>{c.rotate(g.tilt);c.beginPath();c.ellipse(0,0,g.w+7,g.h+6,0,0,TAU);c.fillStyle='#D98BA8';c.fill();ink(c,'crypt.'+g.a,'ellipse',[0,0,(g.w+7)*2,(g.h+6)*2],{stroke:'#A66F97',strokeWidth:1.4,roughness:.55,boil:false},{fill:false});oval(c,0,0,g.w,g.h,'#F6EEF0');for(let i=0;i<26;i++){const a=i/26*TAU,x=Math.cos(a)*(g.w+4),y=Math.sin(a)*(g.h+3);if(i%5===0)oval(c,x,y,3.4,5.3,'#F6EEF0',a);else nuc(c,x,y,2.4,4,a+Math.PI/2);}});}
 for(let i=0;i<390;i++){const a=i/390*TAU;if((mode==='simple'||mode==='suppurative')&&(a<.08||a>TAU-.08))continue;local(c,a,390,()=>{oval(c,0,0,4,8,'#D98BA8');if(i%6===0)oval(c,0,0,3.5,6,'#F6EEF0');else nuc(c,0,0,2.1,4);});}
 for(let i=0;i<12;i++)local(c,i/12*TAU,1020,()=>{c.beginPath();c.rect(-265,-30,530,260);c.clip();tissueTexture(c,.7);});
 for(let i=0;i<230;i++){const a=i/230*TAU;local(c,a,546,()=>nuc(c,0,0,4,1.1));}
 for(const m of muscle){const [x,y]=polar(m.a,m.r);if(!visible(x,y))continue;local(c,m.a,m.r,()=>{c.strokeStyle='rgba(177,84,124,.35)';c.lineWidth=.65;c.beginPath();if(m.r<990){c.moveTo(-20,0);c.bezierCurveTo(-7,-3,12,3,30,0);c.stroke();}else oval(c,0,0,6,5,'rgba(217,139,168,.25)');nuc(c,0,0,m.r<990?m.l:2.4,m.r<990?1.5:2.2);});}
 for(let i=0;i<180;i++){const a=i/180*TAU;local(c,a,1140,()=>nuc(c,0,0,5,1.2));}
 for(const [a,r,size] of vesselSites)local(c,a,r,()=>{c.save();c.scale(size/34,size/34);drawVessels(c,[[0,0,34]]);c.restore();const V=rng(Math.round(r));for(let row=-1;row<=1;row++)for(let col=-3;col<=3;col++){const x=col*7+(V()-.5)*2,y=row*6+(V()-.5)*2;if((x/(size*.67))**2+(y/(size*.50))**2>.86)continue;const a=V()*3;oval(c,x,y,5,3,'#A8404E',a);c.strokeStyle='#7E2A38';c.lineWidth=.28;c.stroke();oval(c,x,y,5*.46,3*.38,'#C9A8AE',a);}});
 // Static HE diapedesis stages: adherent, spanning the wall, extravascular.
 if(mode==='simple')local(c,-.12,670,()=>{for(const [x,y,rot] of [[17,-9,.2],[29,0,0],[47,10,.5]])detailedNeutrophil(c,x,y,{lobes:3,rot,sz:.92},1);});
 // Mild alteration on the return route toward mucosa: pale cytoplasm, pyknotic nuclei.
 if(mode==='simple')for(let i=0;i<9;i++)local(c,.10+i*.018,413+i%3*13,()=>{oval(c,0,0,6,9,'#F0DDE5');oval(c,-1,2,1.7,2.2,'#3F2A66');});
 if(mode!=='chronic')for(const n of neuts){if(n.muscle===true&&mode==='simple'||!n.muscle){const [x,y]=polar(n.a,n.r);if(!visible(x,y,25))continue;if(n.r>552&&follicles.some(f=>{const da=Math.atan2(Math.sin(f.a-n.a),Math.cos(f.a-n.a));return (da*n.r/f.rx)**2+((n.r-f.r)/f.ry)**2<1.18;}))continue;if(n.r<540&&crypts.some(g=>{const da=Math.atan2(Math.sin(n.a-g.a),Math.cos(n.a-g.a));return (da*n.r/(g.w+10))**2+((n.r-g.r)/(g.h+10))**2<1.1;}))continue;if(Math.hypot(x-focus.x,y-focus.y)<445/zoom)visibleNeutrophils++;if(zoom<.65)oval(c,x,y,3,3,'#6B4C9A');else detailedNeutrophil(c,x,y,n,1);}}
 if(mode==='suppurative'){
 const F=rng(10037);for(let i=0;i<7400;i++){const a=F()*TAU,r=100+F()*1060,[x,y]=polar(a,r);if(!visible(x,y,25))continue;const cell={lobes:2+Math.floor(F()*4),rot:F()*TAU,sz:.92};if(i%5===0){oval(c,x,y,7,6,'#EBC3D0');for(let j=0;j<4;j++)oval(c,x+(F()-.5)*9,y+(F()-.5)*8,1.3,1.5,'#3F2A66');}else detailedNeutrophil(c,x,y,cell,1);}
 for(let i=0;i<12;i++)local(c,i/12*TAU,1150,()=>{c.translate(0,-270);c.scale(.9,.9);c.beginPath();c.rect(-430,280,860,140);c.clip();drawHE(c,{style:'ch04',detail:1,neut:0,ulcer:0,fibrin:1,t:0});});
 }
 if(mode==='chronic'){const F=rng(1969);for(let i=0;i<2600;i++){const a=F()*TAU,r=560+F()*520,[x,y]=polar(a,r);if(!visible(x,y))continue;c.strokeStyle='#D98BA8';c.lineWidth=.65;c.beginPath();c.moveTo(x-24,y);c.bezierCurveTo(x-8,y-6,x+12,y+5,x+32,y);c.stroke();if(i%3===0)plasma(c,x,y);else nuc(c,x,y,2.8,3);}}
 // Focal ragged epithelial loss, with a few shed cells in the lumen.
 if(mode==='simple'||mode==='suppurative'){const F=rng(834);for(let i=0;i<25;i++){const x=(F()-.5)*59,y=-386+F()*14;oval(c,x,y,3+F()*4,2,'#EBC3D0',F()*3);}for(let i=0;i<6;i++)nuc(c,-24+i*10,-363+(i%2)*8,2.6,4,i*.7);}
 return {visibleNeutrophils,muscleNeutrophilsOnPlate:mode==='simple'?5:undefined};
}
export const muscleCells=neuts.filter(n=>n.muscle);
// detail: port of film_mini_detail/lib/he_detail.js (neutrophil, chromatin, fibrin mesh, muscle/collagen).
// detail: copied in, not imported across directories. Only he.js state.detail draws these. Seeds are fixed.
// detail: rng runs once at load to bake Path2Ds. render(t) does not call rng, Date, or Math.random.
import { rng, noise2 } from './motion.js';

const R = rng(40417), TAU = Math.PI * 2;
const ellipse = (p, x, y, rx, ry, a = 0) => { p.moveTo(x + Math.cos(a) * rx, y + Math.sin(a) * rx); p.ellipse(x, y, rx, ry, a, 0, TAU); };
const speck = new Path2D();
for (let i = 0; i < 25; i++) { const a = R() * TAU, r = Math.sqrt(R()) * .86; ellipse(speck, Math.cos(a) * r, Math.sin(a) * r, .035 + R() * .065, .04 + R() * .08); }
// detail: 25 chromatin specks. Not stamped on the accepted crypt / muscle nuclei (those shapes stay).
export function chromatin(ctx, x, y, rx, ry, a) { ctx.save(); ctx.translate(x, y); ctx.rotate(a); ctx.scale(rx, ry); ctx.fillStyle = '#38234F'; ctx.fill(speck); ctx.restore(); }
const muscleFibres = new Path2D(), collagen = new Path2D();
for (let i = 0; i < 280; i++) {
  const x = -440 + R() * 880, y = -5 + R() * 230, l = 22 + R() * 65;
  muscleFibres.moveTo(x - l, y); muscleFibres.bezierCurveTo(x - l * .4, y - 5, x + l * .3, y - 4, x + l, y);
  muscleFibres.bezierCurveTo(x + l * .2, y + 5, x - l * .4, y + 4, x - l, y);
}
for (let i = 0; i < 180; i++) {
  const x = -430 + R() * 860, y = -145 + R() * 130, l = 12 + R() * 50;
  collagen.moveTo(x, y); collagen.bezierCurveTo(x + l * .3, y - 7, x + l * .6, y + 8, x + l, y + 2);
}
// detail: microscope hairlines, round caps, no hatch. Muscle and collagen share line width 0.65.
export function tissueTexture(ctx, k) {
  ctx.save(); ctx.globalAlpha *= k; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
  ctx.strokeStyle = 'rgba(177,84,124,.3)'; ctx.lineWidth = .65; ctx.stroke(muscleFibres);
  ctx.strokeStyle = 'rgba(189,106,147,.4)'; ctx.stroke(collagen); ctx.restore();
}
const NR = rng(40303);
// detail: lobe half-axes 4.0×2.9. Centres keep a cytoplasm gap; the inner side pinches 0.14.
const lobeOutline = (path, x, y, a, b, rot, phase, sign) => {
  const N = 36;
  for (let k = 0; k <= N; k++) {
    const t = k / N * TAU, f = 1 + .006 * Math.sin(2 * t + phase) + .004 * Math.cos(3 * t + phase * 1.3), indent = 1 - .14 * Math.exp(-(((t - sign * Math.PI / 2) / .58) ** 2));
    const u = Math.cos(t) * a * f, v = Math.sin(t) * b * f * indent, px = x + u * Math.cos(rot) - v * Math.sin(rot), py = y + u * Math.sin(rot) + v * Math.cos(rot);
    k ? path.lineTo(px, py) : path.moveTo(px, py);
  }
  path.closePath();
};
const lobeSets = [
  [{ x: -3.66, y: 0.17, rot: 1.50 }, { x: 3.54, y: -0.18, rot: 1.72 }],
  [{ x: 0, y: -4.50, rot: -0.22 }, { x: 3.90, y: 2.25, rot: 1.87 }, { x: -3.90, y: 2.25, rot: 3.97 }],
  [{ x: 0, y: -5.85, rot: -0.07 }, { x: 5.85, y: 0, rot: 1.50 }, { x: 0, y: 5.85, rot: 3.07 }, { x: -5.85, y: 0, rot: 4.64 }],
  [{ x: -6.12, y: -4.15, rot: 5.28 }, { x: 1.81, y: -5.72, rot: 5.06 }, { x: 7.65, y: -.2, rot: 1.48 }, { x: 2.21, y: 5.59, rot: 1.2 }, { x: -5.77, y: 4.57, rot: 4.07 }],
];
// detail: cytoplasm ellipses for 2 → 5 lobes (guide §3).
const cellRadii = [[7.20, 5.65], [8.05, 7.55], [9.25, 8.70], [10.625, 10]];
const cells = lobeSets.map((chain, ci) => {
  const lobes = new Path2D(), bridges = new Path2D(), granules = new Path2D(), clumps = new Path2D();
  let inward = 0; for (const p of chain) inward += Math.sin(p.rot) * p.x - Math.cos(p.rot) * p.y; const sign = inward >= 0 ? 1 : -1;
  chain.forEach((p, i) => {
    const ja = .997 + NR() * .006, jb = .997 + NR() * .006;
    lobeOutline(lobes, p.x, p.y, 4 * ja, 2.9 * jb, p.rot, i * 1.7, sign);
    if (i) { const q = chain[i - 1], mx = (p.x + q.x) / 2, my = (p.y + q.y) / 2, ol = Math.hypot(mx, my) || 1; bridges.moveTo(q.x, q.y); bridges.quadraticCurveTo(mx - my / ol * .65, my + mx / ol * .65, p.x, p.y); }
    for (let k = 0; k < 5; k++) ellipse(clumps, p.x + (R() - .5) * 3.1, p.y + (R() - .5) * 2.2, .35 + R() * .4, .32);
  });
  const reach = cellRadii[ci][0] * .78;
  for (let i = 0; i < 22; i++) { const a = R() * TAU, r = reach * Math.sqrt(R()); ellipse(granules, Math.cos(a) * r, Math.sin(a) * r * .94, .22 + R() * .22, .3); }
  return { lobes, bridges, granules, clumps };
});
// detail: opt.bridgePx is the stroke in the caller's pixels (default 0.48, guide §1). Inset passes 1.6 because it is not under the lens scale.
// detail: opt.cytoOutline is inset-only (chapter 03 lockLobes). Field plate omits it — fill stays rgba(226,170,200,.75), no contour stroke.
export function detailedNeutrophil(ctx, x, y, c, s, opt) {
  const n = c.lobes >= 2 && c.lobes <= 5 ? c.lobes : 3;
  const p = cells[n - 2], sc = s * (c.sz || 1), rad = cellRadii[n - 2], bridge = opt && opt.bridgePx != null ? opt.bridgePx : .48;
  ctx.save(); ctx.translate(x, y); ctx.rotate(c.rot || 0); ctx.scale(sc, sc);
  ctx.beginPath(); ctx.ellipse(0, 0, rad[0], rad[1], 0, 0, TAU); ctx.fillStyle = 'rgba(226,170,200,.75)'; ctx.fill();
  // detail: 1.2px screen-space mauve rim. lineWidth is divided by the cell scale, same as the bridge.
  if (opt && opt.cytoOutline) { ctx.strokeStyle = 'rgba(176,122,154,.88)'; ctx.lineWidth = 1.2 / sc; ctx.stroke(); }
  ctx.fillStyle = 'rgba(167,105,159,.38)'; ctx.fill(p.granules);
  ctx.strokeStyle = '#9273A5'; ctx.lineWidth = bridge / sc; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.stroke(p.bridges);
  ctx.fillStyle = '#51336F'; ctx.fill(p.lobes);
  ctx.fillStyle = '#3F2A66'; ctx.fill(p.clumps);
  ctx.restore();
}
const mesh = new Path2D();
for (let i = 0; i < 140; i++) {
  const x = -430 + R() * 860, y = 270 + R() * 110, l = 20 + R() * 65, a = (R() - .5) * 2.4;
  for (let w = 0; w < 3; w++) {
    mesh.moveTo(x, y + w * 1.5); mesh.bezierCurveTo(x + l * .3, y - 12 + w * 2, x + l * .6, y + Math.sin(a) * l, x + l, y + Math.sin(a) * l + w * 2);
    mesh.moveTo(x + l * .5, y + Math.sin(a) * l * .4); mesh.quadraticCurveTo(x + l * .7, y - 12, x + l * .85, y - 16 - R() * 15);
  }
}
// detail: 140 fine strands. Coarse 60 stay in he.js (ratio ~60:140).
export function fibrinMesh(ctx, k) { ctx.save(); ctx.globalAlpha *= k; ctx.strokeStyle = '#C66D92'; ctx.lineWidth = .55; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.stroke(mesh); ctx.restore(); }

// detail: early-plate vessels. Double wall, no Zahn bands (those are thrombosed vessels on the later plate).
// detail: RBC rx uses 5 in place of the old 3.1, so diameter ~10 against a neutrophil cytoplasm of ~14–21 (≈1.5×).
const VR = rng(40717);
function blobRing(cx, cy, rx, ry, seed, amp) {
  const p = new Path2D(), n = 22;
  for (let i = 0; i <= n; i++) {
    const a = i / n * TAU, f = 1 + amp * (noise2(Math.cos(a) * 1.3 + seed, Math.sin(a) * 1.3 + seed * .7) - .5) * 2;
    const x = cx + Math.cos(a) * rx * f, y = cy + Math.sin(a) * ry * f;
    i ? p.lineTo(x, y) : p.moveTo(x, y);
  }
  p.closePath(); return p;
}
let VCACHE = null;
function buildVessels(vessels) {
  return vessels.map((v, i) => {
    const x = v[0], y = v[1], vr = v[2];
    const outer = blobRing(x, y, vr * 1.14, vr * .9, i * 3.1, .1);
    const inner = blobRing(x, y, vr * .78, vr * .62, i * 3.1 + 1.7, .08);
    const clip = blobRing(x, y, vr * .7, vr * .54, i * 3.1 + .4, .06);
    const nuclei = new Path2D(), nn = 4 + Math.floor(VR() * 3);
    for (let k = 0; k < nn; k++) {
      const a = VR() * TAU;
      ellipse(nuclei, x + Math.cos(a) * vr * 1.02, y + Math.sin(a) * vr * .8, 2.6, .65, a + 1.57);
    }
    const discs = [], n = 3 + Math.floor(VR() * 3);
    for (let k = 0; k < n; k++) {
      const a = VR() * TAU, rad = Math.sqrt(VR()) * .62;
      const px = x + Math.cos(a) * vr * .48 * rad, py = y + Math.sin(a) * vr * .36 * rad;
      const rx = 5 * (.72 + VR() * .6), ry = rx * (.36 + VR() * .4), ang = VR() * TAU;
      const disc = new Path2D(), pale = new Path2D();
      ellipse(disc, px, py, rx, ry, ang); ellipse(pale, px, py, rx * .46, ry * .38, ang);
      discs.push({ disc, pale, lysed: VR() < .25, alpha: .55 + VR() * .4 });
    }
    return { outer, inner, clip, nuclei, discs };
  });
}
export function drawVessels(ctx, vessels) {
  if (!VCACHE) VCACHE = buildVessels(vessels);
  const base = ctx.globalAlpha;
  ctx.save(); ctx.lineCap = 'round'; ctx.lineJoin = 'round';
  for (const w of VCACHE) {
    ctx.save(); ctx.clip(w.clip);
    for (const d of w.discs) {
