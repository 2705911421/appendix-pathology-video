    const dx = x0 + col - c.x, dy = y0 + row - c.y;
    return dx * dx + dy * dy < inset * inset;
  };
  const dipAt = (row, col) => {
    if (!inside(col, row) || !inside(col, row - 2) || !inside(col, row + 2)) return false;
    const up = luma(row - 2, col), dn = luma(row + 2, col), mid = luma(row, col);
