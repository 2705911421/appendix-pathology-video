    const iu = ((rt - dist) * w + col) * 4, idn = ((rt + dist) * w + col) * 4;
    for (let ch = 0; ch < 3; ch++) d[i + ch] = Math.round(src[i + ch] * (1 - a) + (src[iu + ch] + src[idn + ch]) * .5 * a);
  };
