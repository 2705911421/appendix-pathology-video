import {paper,text,drawCTStatic,drawCTChanges,drawTissueStatic,drawTissueChanges,drawFocus,drawTissueMark,drawConnector,labelTo,ramp,appendixRadii} from './ct_r3_schematic.js';

const CT={x:610,y:92,w:710,h:838};
