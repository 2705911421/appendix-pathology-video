      document.body.appendChild(d);
    }, [t, marks, safe, W, H]);
    const file = `${out}-t${t.toFixed(2)}.png`;
    await page.screenshot({ path: file, clip: { x: 0, y: 0, width: W, height: H } });
    await page.evaluate(() => document.getElementById('__msr_marks')?.remove());
