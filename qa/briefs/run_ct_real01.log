    const marks = found.filter(f => f.t0 === t).flatMap(f => f.boxes.map(b => ({ ...b, kind: f.kind })));
    await page.evaluate(async ([t, marks, safe, W, H]) => {
      window.__msrText.reset(); await window.render(t);
