## 6. 下载方法（供复核）

Radiopaedia 病例页在带 `Accept: text/html` 或 Googlebot 的请求下可得到含许可证与 study id 的 HTML。完整层面列表来自公开的  
`/studies/<id>/annotated_viewer_json.json`。  
静帧地址为：

`https://prod-images-static.radiopaedia.org/images/<image_id>/<original文件名>`

其中 `<original文件名>` 取自该 JSON 的 `encodings.thumbnailed_files[].original`（新病例多为 `<hash>.jpeg`，本批全部 HTTP 200）。只下载了上述选定层面，没有整堆拉取。  
Wikimedia 原图来自 `upload.wikimedia.org`，许可经 Commons API `extmetadata` 核对。

未改动任何 git 仓库，也未读取或改写 `/workspace/病理科普视频/配音/.mimo.env`。

总览图：`/workspace/病理科普视频/ct_real/contact_sheet.png`
import {initBaker,bake} from './lib/wash.js';
import {bakeHE} from './lib/he.js';
import s08 from './chapters/s08.js';
import {forScene} from './timeline.js';
const name=new URLSearchParams(location.search).get('scene')||'s08';
if(!['s06','s08','s10','s11','s19','s14','s09','s12','s15','s04','ct_library'].includes(name))throw Error('Unknown scene '+name);
const scene=name==='s08'?s08:(await import(`./chapters/${name}.js`)).default;
const ctRanges={s09:[35,36],s12:[47,48],s15:[58,59],s04:[14,19],ct_library:[35,36]};
const clock=ctRanges[name]?forScene(...ctRanges[name],0):name==='s08'?{duration:T.end(34),T}:(name==='s06'?forScene(23,24,0):name==='s14'?forScene(54,57,0):name==='s19'?forScene(69,70,0):forScene(37,name==='s11'?46:42));
import {T} from './timeline.js';
const c=document.getElementById('c');c.width=1920;c.height=1080;const ctx=c.getContext('2d');
await document.fonts.load('500 32px MixSans');if(!ctRanges[name]){await initBaker();bakeHE((k,r,o)=>bake(k,r,{...o,hd:true,soft:true,grain:.12,edge:.3,bleed:.5}));}
scene.prepare();window.DUR=clock.duration;window.render=t=>scene.draw(ctx,t,clock.T);window.READY=true;
// Timing snapshot generated from /workspace/病理科普视频/配音/全稿_v3/timeline.json
// (lines n=29–34, real start/end seconds; no estimated durations).
// Preserve the approved scene through its legacy clock.
import scene from './chapters/s08.js';
import {timing as allTiming} from './timing_snapshot.js';
const timing=allTiming.filter(s=>s.n>=29&&s.n<=34);
export const origin = timing[0].start;
export const sentences = timing.map(s => ({id:s.n,start:s.start-origin,end:s.end-origin}));
export const duration = sentences.at(-1).end + 0.8;
export const T = {
  at: id => sentences[id-29].start,
  end: id => id===34 ? duration : sentences[id-29].end,
  frac: (id,f) => sentences[id-29].start + (sentences[id-29].end-sentences[id-29].start)*f,
};
const legacy = {at:id=>(id-29)*6,end:id=>(id-28)*6,frac:(id,f)=>(id-29+f)*6};
export function sceneTime(t) {
  const s = sentences.find(s=>t<s.end) || sentences.at(-1);
  if(t>=sentences.at(-1).end) return 33; // retain the approved final state for the tail
  return (s.id-29)*6 + Math.max(0,(t-s.start)/(s.end-s.start))*6;
}
const draw = scene.draw;
scene.draw = (ctx,t) => draw.call(scene,ctx,sceneTime(t),legacy);

export function forScene(first,last,tail=.8){
 const rows=allTiming.filter(s=>s.n>=first&&s.n<=last),origin=rows[0].start;
 const row=id=>{const s=rows.find(s=>s.n===Number(id));if(!s)throw Error('Unknown sentence '+id);return s;};
 return {origin,duration:rows.at(-1).end-origin+tail,rows,
 T:{has:id=>rows.some(s=>s.n===id),at:id=>row(id).start-origin,end:id=>row(id).end-origin,frac:(id,f)=>row(id).start-origin+(row(id).end-row(id).start)*f}};
}
import sys,json
from pathlib import Path
from PIL import Image,ImageDraw
scene=sys.argv[1];p=Path('qa/v6/ct')/scene
picks=json.load(open(p/'keyframes.json'))['picks']
files=sorted((p/'stills').glob('*.png'))
files=[f for f in files if 'sheet' not in f.name]
sheet=Image.new('RGB',(960,310*((len(picks)+1)//2)),'#F4EFE6');d=ImageDraw.Draw(sheet)

def crop2(im,box,name):
    w=box[2]-box[0];h=box[3]-box[1]
    im.crop(box).resize((w*2,h*2),Image.LANCZOS).save(p/name)

for i,(f,pick) in enumerate(zip(files,picks)):
    im=Image.open(f).convert('RGB');im.save(p/(pick['name']+'.png'))
    n=int(pick['name'][1:3])
    if scene=='S04':
