# 并行线通用规则（所有并行线必读）

你在一个独立 git worktree 里工作（分支见下），与其他并行线同时进行。主线是 /workspace/病理科普视频/v5 的 v6-fresh 分支（另有线在 v5 和 v5_s19_dev 改 S06/S07/S19，不要碰这些目录）。

**只在你自己的 worktree 里改文件。** 新场景写成 film/chapters/sNN.js；本线专用的绘图库写在 film/lib_ext/<本线名>_*.js。尽量不改共享文件（film/main.js、film/timeline.js、已有 lib_ext）；为了能单独渲染可以改 main.js，但改动要最小、集中，便于我之后合并。
**锁定文件不许改**，开工和收工各做一次 sha256 校验并写入日志：engine/lib/{he,he_detail,wash,ann,scope,camera}.js、parity_r4/chapters/04.js。

先读这些再动手：
- 分镜：分镜/分镜_v1.md（本线场景的行、素材库 B–J 说明、"研究卡/文献提示"表）。
- 配音与时间：配音/全稿_v3/（timeline.json，所有时间按句号对齐，不要写死秒数，后面会重新配音）。
- 风格：/workspace/病理科普视频/v4_mix/qa/style/风格规范_v1.md；版式参考已做好的 S06（qa/v6/h02_s06/s23_red.png、s24_after.png）：浅米色底、左侧标题/要点文字栏、右侧主画面；手绘水彩质感，不要扁平饱和的矢量风。标签规范：细引线 + 浅紫字、无框；所有内容 y<950。
- 渲染：/workspace/garden-skills/skills/motion-showreel/scripts/render.mjs（用法参考 qa/briefs/v6_d01_s11.md 和 qa/v6/ 下已有的 build/render 脚本）。
- brief 格式与交付习惯参考 qa/briefs/v6_d01_s11.md、v6_e01_s19.md。

内容红线：
- 画面文字只能来自定稿解说词/分镜，**不得编造任何数字、研究或文献**；分镜"研究卡/文献提示"表里列出的数字和引注才能上屏，且原样照抄。
- 原创自绘，不用网图/照片；不出现姓名、学校。
- 医学上要准确；拿不准的地方在 自检.md 里列出，不要猜着画。

每个场景交付（qa/v6/<本线名>/<场景>/）：每句 1–2 张关键帧 + 200% 局部、review_sheet.png（关键帧总览）、SNN.mp4 与 SNN_带配音_720p.mp4（配上对应句的真实配音）、自检.md（逐条对照分镜要求和风格规范）。一个场景完成并自检通过就在本分支 commit（`git -c user.name=mini -c user.email=mini@local commit`，信息以本线名开头），然后做下一个场景，全部做完再结束。不要 push，不要合并到 v6-fresh。


**机器负载**：现在有 8 条线同时在这台 8 核/15GB 的机器上跑，渲染时只开 1 个渲染进程/1 个浏览器实例，不要并发多路渲染；预览可先用低分辨率，定稿再出全尺寸。
**提交**：每完成一个场景就在本分支 commit；如果 git 元数据写不进去，把提交打成 qa/v6/<本线名>/<本线名>-dev.bundle 并在日志里说明。
// main_fix01: exudation visual vocabulary for S07, drawn to match the refined
// H&E sample (pale lavender neutrophil cytoplasm + clustered round lobed nuclei,
// pink collagen stroma with spindle fibroblasts).
import {bake,get} from '../lib/wash.js';
import {rng} from '../lib/motion.js';
const TAU=Math.PI*2;
const clamp=x=>Math.max(0,Math.min(1,x));
const mix=(a,b,p)=>a+(b-a)*p;

const fibers=[],dots=[],fibro=[],inflam=[];
function blob(c,x,y,rx,ry,seed,fill,alpha=1){c.save();c.globalAlpha*=alpha;c.beginPath();for(let i=0;i<=64;i++){const a=i/64*TAU,k=1+.055*Math.sin(a*5+seed)+.035*Math.cos(a*3+seed);const xx=x+Math.cos(a)*rx*k,yy=y+Math.sin(a)*ry*k;i?c.lineTo(xx,yy):c.moveTo(xx,yy);}c.closePath();c.fillStyle=fill;c.fill();c.restore();}

export function prepareExudate(){
 const r=rng(72530);fibers.length=dots.length=fibro.length=inflam.length=0;
 for(let i=0;i<118;i++)fibers.push({x:-470+r()*940,y:12+r()*330,l:26+r()*128,a:r()*8,w:1+r()*1.7,s:r()>.5?1:-1});
 for(let i=0;i<18;i++)fibro.push({x:-390+r()*780,y:24+r()*300,rot:(r()-.5)*1.25,l:16+r()*13,c:r()});
 for(let i=0;i<9;i++)inflam.push({x:-400+r()*800,y:60+r()*280,r:8+r()*5,s:r()});
 for(let i=0;i<96;i++)dots.push({x:-285+r()*570,y:r(),s:1.6+r()*2.0,ph:r()*TAU});
 // Pale blue interstitial water: irregular soft blooms, not a flat rectangle.
 bake('s07.fluid',(b,P)=>{
  P.fill(b,P.blob(0,10,300,64,.22,731),'#93C2D6',50,.5,[.3,.5]);
  P.fill(b,P.blob(-110,46,170,54,.3,732),'#A5CEDE',36,.5,[.3,.5]);
  P.fill(b,P.blob(138,-18,150,48,.3,733),'#B4D8E4',32,.5,[.3,.5]);
 },{seed:731,hd:true,soft:true,grain:.1,edge:.24,bleed:.6});
}

// Base interstitium: warm pink ground, dense collagen fibres, spindle fibroblasts,
// a few resident inflammatory cells. Denser and more saturated than the old白底.
export function drawInterstitium(c,wallY,wet,z){
 if(z<=0)return;
 c.save();c.globalAlpha=z;
 const g=c.createLinearGradient(0,wallY,0,wallY+360);
 g.addColorStop(0,'rgba(241,214,221,.60)');
 g.addColorStop(.45,'rgba(233,199,211,.72)');
 g.addColorStop(1,'rgba(226,187,201,.80)');
 c.fillStyle=g;c.fillRect(-500,wallY-4,1000,430);
 // Watercolour mottling so the ground is not a flat fill.
 for(let i=0;i<11;i++){const x=-430+i*86,y=wallY+40+((i*53)%250);blob(c,x,y,90+i%3*22,50+i%4*14,i*1.7,'rgba(214,166,181,.20)');}
 // Collagen: long wavy bundles, pale pink (H&E eosin); separated by edema.
 for(let i=0;i<fibers.length;i++){
  const f=fibers[i],spread=1+wet*.20;
  const y=wallY+18+(f.y)*(spread);
  c.strokeStyle=i%4===0?'rgba(183,120,145,.46)':i%3===0?'rgba(201,146,166,.34)':'rgba(190,132,154,.40)';
  c.lineWidth=f.w*(i%5===0?1.25:1);
  c.beginPath();c.moveTo(f.x,y);c.bezierCurveTo(f.x+f.l*.3,y-9*f.s,f.x+f.l*.68,y+10*f.s,f.x+f.l,y-2*f.s);c.stroke();
  if(i%7===0){c.strokeStyle='rgba(206,156,175,.26)';c.lineWidth=.9;c.beginPath();c.moveTo(f.x+8,y+5);c.bezierCurveTo(f.x+f.l*.4,y+12,f.x+f.l*.7,y+2,f.x+f.l*.92,y+7);c.stroke();}
 }
 // Spindle fibroblast nuclei (dark violet, elongated) with faint cytoplasm.
 for(let i=0;i<fibro.length;i++){
  const f=fibro[i],push=1+wet*.22;
  const x=f.x*(1+wet*.05),y=wallY+30+f.y*push;
  c.save();c.translate(x,y);c.rotate(f.rot);
  c.fillStyle='rgba(224,192,208,.55)';c.beginPath();c.ellipse(0,0,f.l*.95,6,0,0,TAU);c.fill();
  c.strokeStyle='rgba(190,148,170,.45)';c.lineWidth=.7;c.beginPath();c.moveTo(-f.l,0);c.lineTo(-f.l*.62,0);c.moveTo(f.l*.62,0);c.lineTo(f.l,0);c.stroke();
  c.fillStyle='#7A5590';c.beginPath();c.ellipse(0,0,f.l*.60,2.9,0,0,TAU);c.fill();
  c.fillStyle='rgba(156,122,175,.55)';c.beginPath();c.ellipse(-f.l*.2,-.5,f.l*.22,1.2,0,0,TAU);c.fill();
  c.restore();
 }
 // A few mononuclear inflammatory cells (round, not the polymorphs in the vessel).
 for(let i=0;i<inflam.length;i++){
  const d=inflam[i],push=1+wet*.26;
  const x=d.x*(1+wet*.04),y=wallY+44+d.y*push;
  c.fillStyle='rgba(225,200,224,.95)';c.beginPath();c.ellipse(x,y,d.r,d.r*.92,.2,0,TAU);c.fill();
  c.strokeStyle='rgba(150,112,160,.40)';c.lineWidth=.8;c.stroke();
  c.fillStyle='#6B4A85';c.beginPath();c.ellipse(x+1,y-1,d.r*.60,d.r*.54,.3,0,TAU);c.fill();
  c.fillStyle='rgba(158,122,175,.45)';c.beginPath();c.ellipse(x-1.5,y-2.5,d.r*.24,d.r*.20,0,0,TAU);c.fill();
 }
 c.restore();
}

// Water leaking from the endothelium downward; grows sentence by sentence.
export function drawFluid(c,wallY,wet,z){
 if(z<=0||wet<=0)return;
 c.save();c.globalAlpha=z;
 c.beginPath();c.rect(-520,wallY-2,1040,470);c.clip();
 const img=get('s07.fluid');
 if(img){
 const w=430+wet*520,h=150+wet*360;
 c.globalAlpha=z*(.30+.50*wet);
 c.drawImage(img,-w/2,wallY-8,w,h);
 }
 // A thin wet front and a few ripples keep the bloom reading as fluid.
 c.globalAlpha=z*(.20+.26*wet);
 c.strokeStyle='rgba(126,172,192,.55)';c.lineWidth=1.2;
 c.beginPath();c.ellipse(0,wallY+50+wet*90,150+wet*190,44+wet*70,0,.12,Math.PI-.12);c.stroke();
 for(let i=0;i<5;i++){const x=-170+i*86,w=30+i%3*22;
  c.strokeStyle='rgba(139,183,201,.34)';c.lineWidth=1.1;
  c.beginPath();c.moveTo(x,wallY+70+i*23+wet*46);c.quadraticCurveTo(x+w*.5,wallY+64+i*23+wet*46,x+w,wallY+72+i*23+wet*46);c.stroke();}
 c.restore();
}

// Protein particles drift out with the fluid; 96 seeded, so always >=80 visible.
export function drawProtein(c,wallY,protein,wet,z){
 if(z<=0||protein<=0)return;
 c.save();c.globalAlpha=z;
 for(let i=0;i<dots.length;i++){
  const d=dots[i],p=clamp(protein*1.55-d.y*.60);if(p<=.02)continue;
  const x=d.x+Math.sin(i*1.7+d.ph)*p*22+wet*Math.sin(d.ph)*10;
  const y=mix(wallY-30,wallY+36+d.y*150,p);
  const a=Math.min(1,p*5.5);
  c.globalAlpha=z*a*.9;
  c.fillStyle='rgba(157,125,171,.30)';c.beginPath();c.arc(x,y,d.s*1.9,0,TAU);c.fill();
  c.fillStyle='#8A6C9C';c.beginPath();c.arc(x,y,d.s,0,TAU);c.fill();
  c.fillStyle='rgba(214,196,223,.55)';c.beginPath();c.arc(x-d.s*.3,y-d.s*.35,d.s*.36,0,TAU);c.fill();
 }
 c.restore();
}

// Neutrophil: pale lavender cytoplasm, 3-4 small round lobed nuclei in a flower
// cluster. sq>0 stretches the body vertically and spreads the lobes; the waist is
// pinned to wallY so the cell reads as half inside / half outside the endothelium.
export function drawCrossingNeutrophil(c,x,y,wallY,sq){
 c.save();c.translate(x,y);
 const sy=1+.62*sq;
 c.beginPath();
 for(let j=0;j<=96;j++){
  const th=j/96*TAU,yy=Math.sin(th)*27*sy;
  const waist=Math.exp(-Math.pow((yy+y-wallY)/13,2));
  const xx=Math.cos(th)*26*(1-.55*sq*waist);
  j?c.lineTo(xx,yy):c.moveTo(xx,yy);
 }
 c.closePath();
 const g=c.createRadialGradient(-4,-6,3,0,0,33*sy);
 g.addColorStop(0,'#F4E7F1');g.addColorStop(.55,'#E3CEE5');g.addColorStop(.86,'#D0B7D8');g.addColorStop(1,'#B99FC8');
 c.fillStyle=g;c.fill();c.strokeStyle='rgba(126,92,148,.60)';c.lineWidth=1.1;c.stroke();
 // Granules.
 c.fillStyle='rgba(150,110,164,.30)';
 for(let i=0;i<24;i++){const gx=Math.sin(i*4.7)*17*(1-.15*sq),gy=Math.cos(i*2.3)*17*sy;c.beginPath();c.arc(gx,gy,.9,0,TAU);c.fill();}
 // Lobed nucleus: 4 round lobes joined into a loose flower cluster (sample left figure).
 const lobes=[[-6.5,-5.5],[5.5,-5],[6,5],[-5,5.5]];
 const sx=1-.26*sq,spy=1+.55*sq,lr=5.0*(1-.10*sq);
 const pts=lobes.map(([px,py])=>[px*sx,py*spy]);
 c.strokeStyle='#6B4A85';c.lineWidth=1.8;c.lineCap='round';
 for(const [px,py] of pts){c.beginPath();c.moveTo(0,0);c.lineTo(px*.62,py*.62);c.stroke();}
 for(let i=0;i<pts.length;i++){
  const [px,py]=pts[i];
  c.fillStyle='#6B4A85';c.beginPath();
  for(let k=0;k<=40;k++){const a=k/40*TAU,rr=lr*(1+.07*Math.sin(a*3+i));const xx2=px+Math.cos(a)*rr,yy2=py+Math.sin(a)*rr;k?c.lineTo(xx2,yy2):c.moveTo(xx2,yy2);}
  c.closePath();c.fill();
  c.fillStyle='rgba(150,116,170,.28)';c.beginPath();c.arc(px-lr*.24,py-lr*.26,lr*.34,0,TAU);c.fill();
 }
 c.restore();
}
"""Replace only the sentence window. Copy exterior packets and audio.
Boundary GOP is lossless so exterior decoded YUV pixels remain exact; the new
scene itself is encoded CRF16 by render.mjs (720p patch also CRF16).
"""
import pathlib,json,subprocess,math
P=pathlib.Path(__file__).resolve().parent;A=P.parent/'animatic';k=json.loads((P/'keyframes.json').read_text());fps=30
sf=math.ceil(k['origin']*fps);ef=math.ceil((k['origin']+k['duration'])*fps)
def run(a):subprocess.run(list(map(str,a)),check=True)
for suffix,w,h,safe in [('',1920,1080,950),('_720p',1280,720,634)]:
 old=A/('粗剪_v12_h04'+suffix+'.mp4');work=P/('splice'+suffix);work.mkdir(exist_ok=True)
 keys=subprocess.check_output(['ffprobe','-v','error','-select_streams','v:0','-skip_frame','nokey','-show_entries','frame=pts_time','-of','csv=p=0',str(old)]).decode()
 keys=[round(float(s.strip().strip(','))*fps) for s in keys.splitlines() if s.strip().strip(',')];bs=max(i for i in keys if i<=sf);be=min(i for i in keys if i>=ef)
 (work/'window.json').write_text(json.dumps(dict(start_frame=sf,end_frame=ef,gop_start=bs,gop_end=be,fps=fps)))
 patch=P/'S07.mp4'
 if suffix:
  patch=work/'patch.mp4';run(['ffmpeg','-v','error','-y','-threads','2','-i',P/'S07.mp4','-vf','scale=1280:720','-an','-c:v','libx264','-crf','16','-preset','veryfast','-threads','2',patch])
 # Rebuild the enclosing GOP once, losslessly. Only the sentence window passes
 # through overlay; its neighbours round by at most a few code values.
 n=be-bs
 f=f'[1:v]crop={w}:{safe}:0:0,setpts=PTS-STARTPTS+{(sf-bs)/fps}/TB[p];[0:v][p]overlay=0:0:eof_action=pass:enable=\'gte(t,{(sf-bs+.5)/fps})*lt(t,{(ef-bs+.5)/fps})\',trim=end_frame={n},setpts=PTS-STARTPTS[v]'
 run(['ffmpeg','-v','error','-y','-threads','2','-ss',bs/fps,'-i',old,'-i',patch,'-filter_complex_threads','1','-filter_complex',f,'-map','[v]','-frames:v',n,'-an','-c:v','libx264','-crf','1','-preset','veryfast','-pix_fmt','yuv420p','-profile:v','high','-level','4.0','-bf','0','-g','30','-x264-params','repeat-headers=1','-threads','2',work/'middle.mp4'])
 run(['ffmpeg','-v','error','-y','-i',old,'-frames:v',bs,'-map','0:v:0','-an','-c:v','copy',work/'before.mp4'])
 run(['ffmpeg','-v','error','-y','-ss',be/fps,'-i',old,'-map','0:v:0','-an','-c:v','copy',work/'after.mp4'])
 (work/'concat.txt').write_text(''.join("file '"+str((work/(n+'.mp4')).resolve())+"'\n"+(f'duration {d}\n' if d is not None else '') for n,d in [('before',bs/fps),('middle',(be-bs)/fps),('after',None)]))
 out=A/('粗剪_v13'+suffix+'.mp4')
 run(['ffmpeg','-v','error','-y','-f','concat','-safe','0','-i',work/'concat.txt','-i',old,'-map','0:v:0','-map','1:a:0','-c','copy','-movflags','+faststart',out])
 if suffix:run(['ffmpeg','-v','error','-y','-ss',sf/fps,'-i',out,'-t',(ef-sf)/fps,'-c:v','libx264','-crf','16','-preset','veryfast','-threads','2','-c:a','aac','-b:a','192k',P/'S07_带配音_720p.mp4'])
import fs from 'node:fs';import {execFileSync as run} from 'node:child_process';import {createCanvas,Path2D} from '@napi-rs/canvas';
globalThis.Path2D=Path2D;globalThis.document={createElement:()=>createCanvas(1,1)};
const {forScene}=await import('../../../film/timeline.js');const {timing}=await import('../../../film/timing_snapshot.js');
const gi=timing.findIndex(s=>s.n===23),gap=timing[gi+1].start-timing[gi].end;
const clock=forScene(23,24,gap),T=clock.T;
const P='qa/v6/h04_s06',tool='/workspace/garden-skills/skills/motion-showreel/scripts/render.mjs';
const picks=[['s23_start',T.frac(23,.03)],['s23_transition',T.frac(23,.42)],['s23_red',T.frac(23,.88)],['s24_anchor',T.frac(24,.25)],['s24_before',T.frac(24,.32)],['s24_after',T.frac(24,.88)]].map(([name,t])=>({name,t}));
fs.writeFileSync(P+'/keyframes.json',JSON.stringify({origin:clock.origin,duration:clock.duration,picks},null,2));
function render(args){run('node',[tool,'film',...args],{stdio:'inherit'});}
render(['--q','scene=s06','--still',picks.map(p=>p.t.toFixed(6)).join(','),'--out',P+'/stills']);
render(['--q','scene=s06','--determinism']);
render(['--q','scene=s06','--out',P+'/S06.mp4','--crf','16','--fps','30','--workers','1']);
# 画面风格规范 v1

照 `film_mini_detail` 第 04 章样帧执行（`he.js`、`he_detail.js`、`chapters/04.js`、`wash.js`、`ann.js`；该分支没有 `lib/detail.js`）。数量用代码里的同一套 `rng` 跑出。画布 1920×1080。镜下是局部坐标 ±420，装进目镜 `{x:640, y:480, r:340}`，缩放 `k = 340/420 × fs`（04 的 `fs` 从 1.06 到 1.48）。

## 1. 线条

结构层用 Rough.js（`ink.js`）：默认 `strokeWidth 2.6`、`roughness .9`、`bowing .8`、`seed 3`、圆头，墨色 `#2A2A35`。路径固定种子缓存一次，出现靠虚线揭开。抖动 `BOIL_FPS = 10`、3 变体；04 镜检 `boil: false`、`drift: false`。已有 `roughness`：.5 .55 .6 .7 .8 1；`bowing` 只在疼痛线为 .5。日常线宽 1.4–3；4.5–9 只留给已有的疼痛线、神经高亮、十字和阑尾。排线只给人物：头发角度 −30、间距 4、`fillWeight 2`；裤子 −60、间距 10、`fillWeight 1.1`。镜下不排线。

镜下圆头细线（视野坐标）：上皮 7，血管轮廓 2.2，纤维素粗丝 `2.4×(1−0.85×detail)`（满细节 0.36），细网 0.55，肌/胶原/影细胞 0.65，裂隙纤维素 0.75 与 0.45，核桥 `0.48/缩放`，红细胞边 0.28，外壁 1.45、内壁 0.85。目镜圈 5、外圈 1.5；闪边宽 8，只在镜圈。标注锁在屏幕像素：引线 1.6，阶段轴 2，刻度 2.4，穿孔环 3。

## 2. 配色

病理色不随情绪变。`mood.js` 只动纸和网格：纸从 `#F4EFE6` 做轻微冷中性、压暗或提亮。玻片底固定 `#F6EEF0`。目镜外 `#111114`；深底上墨色由 `setDark` 混向 `#EFE8DC`。

- 墨 `#2A2A35`。朱红 `#D6453A`（活组织、炎症、重点字、镜圈）。字幕里的朱红用 `#F07A63`。
- H&E 紫 `#6B4C9A`（核、内皮核）。核深 `#3F2A66`，染色质点 `#38234F`，碎屑深 `#2E1F45`，叶填 `#51336F`。
- 嗜伊红 `#D98BA8`，浅 `#EBC3D0`。胞质 `rgba(226,170,200,.75)`，颗粒 `rgba(167,105,159,.38)`，核桥 `#9273A5`。
- 出血红褐：盘 `#A8404E`、边 `#7E2A38`、中央淡区 `#C9A8AE`、溶血 `#C9A4AC`。出血斑 `#8E3A3E` `#A8404E` `#9A3E48` `#7A3038`。Zahn 红层 `#8E3A3E`/`#A8404E`，粉层 `#F0D4DC`/`#F3D5DE`。充盈水彩 `#C9455A` 在坏疽期让开。
- 镜下脓 `#B39459`（`C.pus`）。大体脓苔只用 02 的 `#CDB98A`。坏死晕 `#D7A3B3` `#E3B7C4` `#E7C9D2`。裂隙底 `#E9DDB0`。网格 `rgba(42,42,53,.07)`。

## 3. 细胞与组织

中性粒用 `detailedNeutrophil`。叶数：2 叶 15%、3 叶 45%、4 叶 30%、5 叶 10%。叶半轴 4.0×2.9，内侧收 0.14，叶间留胞质缝，二次曲线核桥相连，每叶 5 个染色质团。胞质椭圆（2→5 叶）7.20×5.65、8.05×7.55、9.25×8.70、10.625×10，内 22 颗颗粒。`chromatin()` 另是 25 个点，盖隐窝核和肌核。`detail=0` 时仍走简笔，03 不被改掉。

全板 **1336** = 腔 186 + 浸润 1150。叶数 222 / 566 / 412 / 136。浸润：黏膜 378、黏膜下层 228、肌层 306、浆膜 84、纤维素带 154。

圆视野（半径 `420/fs`）：

- 早期 `neut=0.2`、`fs=1.06`：游出 166，腔内 71。
- 全层、`fs=1.15`：**912**（黏膜 298、黏膜下层 204、肌层 262、浆膜 45、纤维素带 48、腔 55）。
- 坏疽峰值 `fs=1.48`、场偏移 `[145.9, 60]`：圆内 471 个位置，按坏死权重抹掉 403，留 68。裂隙另有 45 个（2–5 叶），不参与这轮剔除。

红细胞 `pushDisc`：`rx=5×(0.72–1.32)`（04 样帧原为 3.1，已按 look 改为 5），`ry=rx×(0.36–0.76)`，淡区 0.46×0.38；`rnd<.25` 为溶血。屏幕上的喷洒盘 **354**，溶血 92，聚在 5 块红褐斑和 6 条血管旁。每条血管有外壁、内壁、内皮核 4–6（本种子 4,4,4,5,5,4）、Zahn 带 3–5 层红粉交替（本种子 3,3,5,4,3,4），最内层填实。影细胞 52 个淡轮廓（`CG()<0.38` 开口）。核碎屑 90 簇 502 粒，核尘 1050。纤维素：60 条粗丝 + 140 条细网。隐窝 13×16 核，肌核 170。穿孔向浆膜加宽，浆膜端脓团 95、核 80。

**比例（look 定）：**红细胞直径约 7.5 μm，中性粒细胞约 10–12 μm，后者约为前者的 1.5 倍。中性粒胞质直径 14–21 时，红细胞 `rx` 应约 5（直径约 10），不再用 3.1。

### 3b. 正常阑尾组织学（01–03 必须有）

- 黏膜下层有成片的淋巴滤泡：深紫色的淋巴细胞团，中间是淡色的生发中心。
- 肌层分两层：内层是环行肌，横截面上的核是小圆点；外层是纵行肌，核呈梭形。
- 隐窝画成管状腺，内衬柱状上皮，夹有杯状细胞。

## 4. 水彩

只烘一次。默认 1024；`hd:true` 输出 **2048**，颗粒在成图像素上重铺（3px 与 18px fbm，权重 .65/.35）。04 近景色素：`hd:true, soft:true, grain:.12, edge:.3, bleed:.5`。`edge` 是干边压暗，`bleed` 向外渗。四个坏死斑再 `blur(15px)`。`scaleBrushes` 会连乘（默认 2.4）；多烘之后用四次 `1/2.4` 把笔刷还回去。

`drawWash` 的 `size` 再乘目镜或相机，才是屏幕像素。屏幕像素 / 烘焙边长 **> 1** 就是拉伸，要改 2048 重烘。审计把相对 1024 超过 1.1 标为需要 hd。共享层带 `he.bands` 仍是 1024，峰值约 1.20 倍，这是旧层；新的近景色素不要照它放大。

## 5. 标注

`ann.js`。字号是屏幕像素。字重用 100–900 的整百；片内实际是 **500**（默认、字幕）、**700**（标题）、**800**（诊断名、三型）。镜旁 22–30，站名 40，诊断 52 与 62；章标题 56 / 章号 22。字幕 44，基线 `y=1012`，只由 `subtitle.js` 画。

描边文字：`label({halo:true})`，先描后填，默认线宽 5，纸色或 `rgb(17,17,20)`。字幕光晕线宽 6。斜引线 `leader`：锚点半径 4，线宽 1.6，先到肘点再走水平字托（03 的「黏膜破溃缺损」）。`elbow:true` 时斜段不超过水平距离。04 穿孔用半径 52、线宽 3 的圆环，字放在镜缘外。

构图停在 `y < 900`（`SAFE.fadeTop`）。镜下注释用短标签，冒号前是看法、冒号后是所见，与「时间倒回：发病早期」同一结构，如「镜下：坏死组织结构消失、出血」。03 镜缘已有「HE 染色 · 阑尾壁」「核分 2–5 叶」。04 现片还没有「镜下：」四字；要加就用 `A.label`，可加 halo，放在阶段轨下、`y<900`，只用 `T.frac` / `T.end` 进出。

## 6. 时序与工程

节拍只用 `T.at(i, 偏移)`、`T.end(i, 偏移)`、`T.frac(i, 0–1)`，时间来自 `narration.json`（否则 `sentences.tsv`）。不规则形状在加载时按固定种子写入局部坐标。帧内随机用 `render(t)` 里的 `rng(种子)`。禁止 `Math.random()`、`Date.now()`、`performance.now()`。水彩只在 `bake()` 里生成。交接帧用 `T.end(末句) − 1e-3` 重画上一章末态（`drawExit04`）。每章导出 `EXIT_*`。画面上新的数字要能指回句子、教材或已有常量；04 没有新计数，也没有比例尺。

## 6b. 动态规则

「活的表面」（`lib/alive.js`）只用在大体标本、人体示意图和 05 章的血管示意图上；H&E 镜下视野一律不开，镜下的动态靠镜头推拉和对焦变化（look 定）。

## 7. 自检清单

1. 结构线是否仍是 2.6 / .9 / .8，或沿用已有覆盖；镜下有没有排线。
2. 1080p 下能否数出 2–5 叶，叶间有胞质缝和核桥。
3. 镜下细胞密度是否接近第 3 节量级（满层浸润的圆视野约 900 个中性粒，早期约 150–250）；坏死区是否只留无核影细胞和核碎屑，活的中性粒集中在坏死区边缘。（第 3 节的具体计数是 04 的实测值，其他章按同一密度量级做，不要照抄数字。）
4. 红细胞是否双凹加淡区；中性粒细胞与红细胞大小比约 1.5:1（`rx`≈5）；血管是否有双层壁和 3–5 层红/粉血栓。
5. 有纤维素渗出的地方，是否同时画了粗丝和细网（04 的比例约 60 : 140）。
6. 色是否落在第 2 节；纸色是否只走 `mood.js`。
7. 近景水彩是否 2048，屏幕像素有没有超过烘焙边长。
8. 字是否都在 `y<900`，字重是否为 500 / 700 / 800，斜引线是否走 `leader`。
9. 节拍是否全是句子索引；交接帧是否等于上一章末帧减 0.001 秒。
10. `--determinism` 换序是否一致；新数字有没有出处。
11. 正常组织（01–03）：黏膜下层有带生发中心的淋巴滤泡，肌层内环（圆点核）外纵（梭形核），隐窝是管状的、有柱状上皮和杯状细胞。
