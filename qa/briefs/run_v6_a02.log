function visualKey(state) {
  if (!state) return 'none';
  const q = (a) => (a >= 0.999 ? 1 : a <= 0.001 ? 0 : Math.round(a * 1000) / 1000);
  return `${state.cn}\t${state.en}\t${q(state.cnA)}\t${q(state.enA)}`;
