    P.fill(b, P.blob(36, -12, 110, 16, .32, 10), '#E8C878', 80, .35, [.3, .4]);
  }, { ...WASH, seed: 29, scale: 1 });
  pin('g.meso');
  buildPus();
}

function paintMeso(ctx, swell) {
  const loop = mesoLoop(swell);
  ctx.save();
  path(ctx, loop); ctx.clip();
  ctx.fillStyle = '#E2B85A';
  path(ctx, loop); ctx.fill();
  const N = 26;
  for (let i = 0; i < N; i++) {
    const step = MESO_TIP / N;
    const s0 = step * i, s1 = Math.min(MESO_TIP, step * (i + 1.25));
    const h0 = mesoHang(s0), h1 = mesoHang(s1);
    if (h0 < 4 && h1 < 4) continue;
    const a = mesoPt(s0, swell, 0), b = mesoPt(s1, swell, 0);
    const c = mesoPt(s1, swell, h1), d = mesoPt(s0, swell, h0);
    const g = ctx.createLinearGradient(a[0], a[1], d[0], d[1]);
    // Whole hang stays yellow fat. The old 0.8 stop (#F6E6BC) turned the lower two-thirds cream.
    g.addColorStop(0, '#C4923E');
    g.addColorStop(0.14, '#D4A84E');
    g.addColorStop(0.48, '#E4BE62');
    g.addColorStop(0.78, '#E8C56E');
    g.addColorStop(1, '#D4A84E');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]); ctx.lineTo(c[0], c[1]); ctx.lineTo(d[0], d[1]);
    ctx.closePath(); ctx.fill();
  }
  for (let s = 0.04; s < MESO_TIP; s += 0.07) {
    const h = mesoHang(s);
    if (h < 20) continue;
    const p = mesoPt(s, swell, h * 0.62);
    drawPinned(ctx, 'g.meso', p[0], p[1], h * 0.55 / 240 * 1024, { alpha: 0.22, blend: 'multiply' });
  }
  ctx.restore();
}

function vesselGeom(swell) {
  const R = rng(12007);
  const artery = [], vein = [];
  let s = 0.04, fa = 0.62, fv = 0.4;
  while (s < 0.74) {
    const h = mesoHang(s);
    artery.push(mesoPt(s, swell, Math.max(3, h * fa)));
    vein.push(mesoPt(s, swell, Math.max(3, h * fv)));
    s += 0.048;
    fa = Math.max(0.3, Math.min(0.78, fa + (R() - 0.5) * 0.16));
    fv = Math.max(0.22, Math.min(0.58, fv + (R() - 0.5) * 0.12));
  }
  const branches = [];
  [0.14, 0.32, 0.5].forEach((s0, i) => {
    const h = mesoHang(s0);
    const f = frameAt(s0);
    const start = mesoPt(s0, swell, h * (0.5 + 0.08 * i));
    const mid = mesoPt(s0 + 0.03, swell, h * 0.28);
    const end = mesoPt(s0 + 0.02, swell, h * 0.06);
    // A small sideways jog so the branch is not a ruler line.
    mid[0] += f.tx * (i % 2 ? 8 : -8);
    mid[1] += f.ty * (i % 2 ? 8 : -8);
    branches.push([start, mid, end]);
  });
  return { artery, vein, branches };
}

function lobules(swell) {
  const out = [];
  for (let i = 1; i < 36; i++) {
    const s0 = MESO_TIP * (i - 1) / 36, s1 = MESO_TIP * i / 36, s2 = MESO_TIP * (i + 1) / 36;
    const h1 = mesoHang(s1);
    if (h1 >= mesoHang(s0) && h1 >= mesoHang(s2) && h1 > 56) out.push({ s: s1, h: h1 });
  }
  return out;
}

// Small warm caps on the free-edge bulges. No cream coins and no white centres.
function paintLobules(ctx, swell, alpha) {
  if (alpha <= 0) return;
  ctx.save();
  path(ctx, mesoLoop(swell)); ctx.clip();
  lobules(swell).forEach(L => {
    const f = frameAt(L.s);
    const ang = Math.atan2(f.ty, f.tx);
    const belly = mesoPt(L.s, swell, L.h * 0.8);
    const lit = mesoPt(L.s, swell, L.h * 0.6);
    ctx.fillStyle = `rgba(168, 112, 40, ${0.62 * alpha})`;
    ctx.beginPath();
    ctx.ellipse(belly[0], belly[1], L.h * 0.2, L.h * 0.12, ang, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = `rgba(226, 176, 78, ${0.78 * alpha})`;
    ctx.beginPath();
    ctx.ellipse(lit[0], lit[1], L.h * 0.16, L.h * 0.1, ang, 0, Math.PI * 2);
    ctx.fill();
  });
  ctx.restore();
}

// Opaque yellow dabs laid across the artery so it dives through the fat instead of sitting on top.
function paintFatDabs(ctx, swell) {
  const R = rng(8801);
  ctx.save();
  path(ctx, mesoLoop(swell)); ctx.clip();
  for (let i = 0; i < 11; i++) {
    const s = 0.08 + i * 0.058;
    const h = mesoHang(s);
    if (h < 22) continue;
    const c = mesoPt(s, swell, h * (0.4 + R() * 0.28));
    const f = frameAt(s);
    const ang = Math.atan2(f.ty, f.tx) + (R() - 0.5) * 0.5;
    ctx.fillStyle = i % 2 ? 'rgba(232, 196, 108, 0.9)' : 'rgba(210, 162, 62, 0.9)';
    ctx.beginPath();
    ctx.ellipse(c[0], c[1], 8 + R() * 12, 5 + R() * 5, ang, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.restore();
}

// t = 0 on the mesenteric (shadow) wall, t = 1 on the lit serosa. Opaque, so overlaps do not darken.
function crossColor(look, t) {
  const sh = look.shadow, base = look.base, gl = look.gloss;
  const u = Math.max(0, Math.min(1, t));
  const stops = [0, 0.16, 0.34, 0.52, 0.74, 0.9, 1];
  const cols = [
    mix3(sh, base, 0.16),
    mix3(sh, base, 0.42),
    mix3(sh, base, 0.76),
    base,
    mix3(base, gl, 0.32),
    mix3(base, gl, 0.58),
    mix3(base, gl, 0.16),
  ];
  let i = 0;
  while (i < stops.length - 2 && u > stops[i + 1]) i++;
  const span = stops[i + 1] - stops[i] || 1;
  return mix3(cols[i], cols[i + 1], (u - stops[i]) / span);
}
function quad(ctx, a, b, c, d) {
  ctx.beginPath();
  ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]); ctx.lineTo(c[0], c[1]); ctx.lineTo(d[0], d[1]);
  ctx.closePath(); ctx.fill();
}
// Static style frames for the resected appendix (S01 / S06 / S11 / S13 / S14).
// t∈[0,1) normal · [1,2) red · [2,3) yellow · [3,4) black · [4,5) 2×2 contact.
import { C } from '../lib/tokens.js';
import { grid } from '../lib/ink.js';
import * as A from '../lib/ann.js';
import {
  prepare as bakeGross, drawAppendix, drawNotes, drawTitle,
  STATES, META,
} from '../lib_ext/gross_appendix.js';

const POSE = { x: 1210, y: 390, rot: -.16, sc: 1.42 };

function paper(ctx, { ruled = true } = {}) {
  // Reset clip / composite leftovers from a previous render(t). Assigning width clears the stack.
  ctx.canvas.width = 1920;
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.globalAlpha = 1;
  ctx.globalCompositeOperation = 'source-over';
  ctx.fillStyle = C.paper;
  ctx.fillRect(0, 0, 1920, 1080);
  if (ruled) { ctx.save(); ctx.globalAlpha = .85; grid(ctx, -40, -40, 1960, 1120, 40); ctx.restore(); }
}

function viewMode() {
  try { return new URLSearchParams(location.search).get('view') || ''; }
  catch { return ''; }
}

function drawOne(ctx, state) {
  drawAppendix(ctx, state, POSE);
  drawTitle(ctx, state);
  drawNotes(ctx, state, POSE);
}

function cellPose(col, row) {
  const x0 = 80, y0 = 70, gap = 28;
  const cw = (1920 - x0 * 2 - gap) / 2, ch = (900 - y0 - gap) / 2;
  return {
    box: { x: x0 + col * (cw + gap), y: y0 + row * (ch + gap), w: cw, h: ch },
    pose: {
      x: x0 + col * (cw + gap) + cw * .52,
      y: y0 + row * (ch + gap) + ch * .56,
      rot: -.12,
      sc: .82,
    },
  };
}

const cellCv = document.createElement('canvas');
function blitCell(ctx, state, pose, box) {
  const w = Math.ceil(box.w), h = Math.ceil(box.h);
  if (cellCv.width !== w || cellCv.height !== h) { cellCv.width = w; cellCv.height = h; }
  const c = cellCv.getContext('2d');
  c.setTransform(1, 0, 0, 1, 0, 0);
  c.globalAlpha = 1;
  c.globalCompositeOperation = 'source-over';
  c.fillStyle = C.paper;
  c.fillRect(0, 0, w, h);
  drawAppendix(c, state, { ...pose, x: pose.x - box.x, y: pose.y - box.y });
  ctx.drawImage(cellCv, box.x, box.y);
}

function drawGrid(ctx) {
  const layout = [[0, 0, 'normal'], [1, 0, 'red'], [0, 1, 'yellow'], [1, 1, 'black']];
  layout.forEach(([col, row, state]) => {
    const { box, pose } = cellPose(col, row);
    const m = META[state];
    blitCell(ctx, state, pose, box);
    A.label(ctx, m.diag, box.x + 18, box.y + 28, { size: 28, w: 800, col: m.tone, halo: true });
    A.label(ctx, m.sub, box.x + 18, box.y + 58, { size: 18, w: 500, alpha: .7, halo: true });
  });
  A.label(ctx, '大体标本 · 四态', 96, 980, { size: 22, w: 500, alpha: .5 });
}

export default {
  prepare() { bakeGross(); },
  draw(ctx, t) {
    // view=morph: continuous stage = t (0–3), specimen only, no labels and no digits.
    if (viewMode() === 'morph') {
      paper(ctx, { ruled: false });
      const stage = Math.max(0, Math.min(3, t));
      drawAppendix(ctx, stage, { x: 960, y: 500, rot: -.16, sc: 1.28 });
      return;
    }
    paper(ctx);
    const i = Math.min(4, Math.max(0, Math.floor(t + 1e-9)));
    if (i < 4) drawOne(ctx, STATES[i]);
    else drawGrid(ctx);
  },
};

