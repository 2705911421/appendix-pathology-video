  bake('g.necro', (b, P) => {
    NEC_PATCHES.forEach((spec, j) => {
      P.fill(b, smearPoly(spec[0], spec[1], spec[2], spec[3], 4200 + j * 19), spec[4], 230, .18, [.3, .4]);
    });
  }, { ...WASH, seed: 27, scale: 1 });
