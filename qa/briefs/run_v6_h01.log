export function toScreen(pose, p) {
  const c = Math.cos(pose.rot), sn = Math.sin(pose.rot);
  return [pose.x + (p[0] * c - p[1] * sn) * pose.sc, pose.y + (p[0] * sn + p[1] * c) * pose.sc];
}
