  const measurePath = path.join(opt.outDir, 'english_measure.json');
  let measured = null;
  let overlayCheck = null;
  let qaPaths = null;
  let qaMeta = null;
  await withPage(path.join(root, 'subtitle'), 'http://subtitle.local', async (page) => {
