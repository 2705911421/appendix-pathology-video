  c.fillStyle=kind==='gob'?'rgba(236,214,220,.8)':kind==='fray'?'rgba(206,138,166,.82)':'rgba(220,168,190,.72)';
  c.fill(kind==='gob'?p.gob:kind==='fray'?p.fray:p.body);
