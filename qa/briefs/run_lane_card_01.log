export function text(c,s,x,y,size=36,color='#2A2A35',weight=500){c.fillStyle=color;c.font="'`${weight} ${size}px MixSans`;c.fillText(s,x,y);}
export function line(c,pts,key,color='"'#A38AB5',k=1){ink(c,'card.'+key,'curve',[pts],{stroke:color,strokeWidth:1.6,seed:41,boil:false},{k});}
export function paper(c){c.setTransform(1,0,0,1,0,0);c.fillStyle='#F4EFE6';c.fillRect(0,0,1920,1080);}
export function nav(c,x=85,y=120,active=-1){['红','黄','黑'].forEach((s,i)=>{c.save();c.globalAlpha=active<0||i===active?1:.35;text(c,s,x+i*115,y,38,colors[i],700);c.restore();if(i<2)text(c,'→',x+53+i*115,y,30,'#AC98B7');});}
export function card(c,heading,rows,{x=85,y=250,w=410,tone='#6B4C9A'}={}){text(c,heading,x,y,46,tone,700);line(c,[[x,y+27],[x+w*.51,y+29],[x+w,y+26]],'underline'+x+y,'#C9B9CA');rows.forEach((s,i)=>text(c,s,x,y+105+i*58,36));}
export function label(c,s,x,y,px,py){text(c,s,x,y,32,'#A38AB5');line(c,[[px,py],[x+28,y+13],[x+180,y+13]],'label'+s+x);}
export function path(c,branch=0,active=2){
 const ys=[285,435,640];const names=[['单纯性'],['化脓性','（蜂窝织炎性）'],['坏疽性']];
 names.forEach((rows,i)=>{c.save();c.globalAlpha=i<=active?1:.3;rows.forEach((s,j)=>text(c,s,115,ys[i]+j*51,j?34:43,colors[i],700));if(i<2)line(c,[[130,ys[i]+(i?85:40)],[130,ys[i]+(i?111:85)],[130,ys[i]+(i?130:110)]],'chain'+i,'#AD9BAF');c.restore();});
 if(branch>0){c.save();c.globalAlpha=branch;line(c,[[342,285],[487,325],[558,435]],'branch0');line(c,[[342,435],[478,502],[558,570]],'branch1');text(c,'…',560,454,40,'#A38AB5');text(c,'…',560,589,40,'#A38AB5');text(c,'非固定路径',115,805,36,'#6B4C9A');c.restore();}}
export function people(c,{pain=0,alpha=1,x=1160,y=510,scale=.7}={}){c.save();c.globalAlpha*=alpha;c.translate(x,y);c.scale(scale,scale);c.translate(-960,-610);drawFigure(c,{face:pain?'pain':'calm',hatch:.6});drawArmR(c,{pose:pain?'clutch':'rest'});c.restore();}
export function doctor(c,x=1510,y=510,scale=.7){people(c,{x,y,scale});c.save();c.translate(x,y);c.scale(scale,scale);ink(c,'card.coat','linearPath',[[[-55,-260],[-6,-145],[-55,160],[55,160],[6,-145],[55,-260]]],{stroke:'#A38AB5',seed:71});ink(c,'card.clipboard','polygon',[[[-170,0],[-65,0],[-65,125],[-170,125]]],{fill:'#E6DCE8',fillStyle:'solid',seed:72});c.restore();}
export function assess(c,p=1){people(c,{x:1050,y:490,pain:0});doctor(c,1510,490);line(c,[[1160,570],[1270,535],[1375,560]],'assess','#A38AB5',p);label(c,'医生评估',1350,820,1505,654);}
