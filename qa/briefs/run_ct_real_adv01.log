    perforation.js, clinical.js, symptom_compare.js, research_card.js
    specimen_pathology.js, surgery_timing.js, path_branch.js
    chronic_transition.js, he_chronic.js, chronic_cells.js
    closing.js, reference_entry.js
  assets/
    wash/                     # 可复用配方生成的新烘焙资产
    fonts/                    # 核对字形覆盖后的字体
    references/               # 定稿所链接、已核对的原有文献资料
  vendor/                     # Rough.js、p5 与 p5.brush 依赖
