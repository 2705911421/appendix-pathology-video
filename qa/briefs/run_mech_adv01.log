"""Named keyframes, 200% crops, and the review sheet for S13."""
import json
from pathlib import Path
from PIL import Image, ImageDraw, ImageFont

P = Path(__file__).resolve().parent
k = json.loads((P / 'keyframes.json').read_text())
font = ImageFont.truetype('/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc', 28)

# 360×360 windows on the thing each sentence is actually showing.
BOX = {
    's49_start': (1000, 240, 1360, 600),
    's49_pressure': (1000, 240, 1360, 600),
    's50_squeeze': (1200, 150, 1640, 590),
    's50_thrombus': (1180, 430, 1660, 810),
    's51_necrosis': (1300, 250, 1760, 710),
    's51_bleed': (1340, 260, 1780, 700),
    's52_pigment': (1360, 200, 1800, 640),
    's53_gross': (1280, 550, 1600, 870),
    's53_end': (1280, 550, 1600, 870),
}

paper = (244, 239, 230)
rows = []
for p in k['picks']:
    im = Image.open(P / 'stills' / f"t_{p['t']:06.2f}.png").convert('RGB')
    im.save(P / f"{p['name']}.png")
    box = BOX[p['name']]
    dw, dh = box[2] - box[0], box[3] - box[1]
    detail = im.crop(box).resize((dw * 2, dh * 2), Image.Resampling.NEAREST)
    detail.save(P / f"{p['name']}_200pct.png")
    px = im.load()
    w, h = im.size
    worst = 0
    for y in range(950, h):
        for x in range(0, w, 8):
            r, g, b = px[x, y]
            worst = max(worst, abs(r - paper[0]), abs(g - paper[1]), abs(b - paper[2]))
    rows.append((p, im, detail, worst))

sheet_h = 40 + len(rows) * 760
sheet = Image.new('RGB', (1760, sheet_h), '#F4EFE6')
d = ImageDraw.Draw(sheet)
for i, (p, im, detail, worst) in enumerate(rows):
    y = 20 + i * 760
    d.text((20, y), f"{p['name']}  t={p['t']:.2f}s   底栏最大偏差 {worst}", font=font, fill='#2A2A35')
    sheet.paste(im.resize((900, 506)), (20, y + 40))
    # fit the 200% crop beside it
    detail.thumbnail((760, 680), Image.Resampling.NEAREST)
    sheet.paste(detail, (960, y + 40))
    d.text((960, y), '200% 局部', font=font, fill='#2A2A35')
sheet.save(P / 'review_sheet.png')
print('sheet', sheet.size)
for p, im, detail, worst in rows:
    print(f"{p['name']:16} bottom-band {worst}")
// Lane mech: appendix cross-section for the intraluminal-pressure beat (S13, sentence 49).
// Paper watercolour, ink outline. The lumen distends as pressure rises while the wall and its
// intramural vessels are squeezed; short radial arrows are the only pressure cue (no scale).
import { bake, get } from '../lib/wash.js';
import { rng } from '../lib/motion.js';

const TAU = Math.PI * 2;
const speck = [];

export function prepareCross() {
  speck.length = 0;
  const r = rng(55201);
  for (let i = 0; i < 90; i++) speck.push({ a: r() * TAU, d: Math.sqrt(r()), s: .5 + r() * 1.4 });
  try { bake('mech.cross', (b, P) => {
    P.fill(b, P.blob(0, 0, 300, 38, .16, 551), '#C9455A', 38, .4, [.3, .4]);
    P.fill(b, P.blob(0, 0, 210, 30, .16, 552), '#8E3A3E', 30, .4, [.3, .4]);
  }, { seed: 551, scale: 1, hd: true, soft: true, grain: .24, edge: .42, bleed: .6 }); } catch {}
}

const wob = (a, k, p) => 1 + .045 * Math.sin(a * 5 + 1.2 + p) + .022 * Math.sin(a * 9 + .4);

function ring(c, cx, cy, ro, ri, wobA, wobB, p) {
  c.beginPath();
  for (let i = 0; i <= 96; i++) {
    const a = i / 96 * TAU, r = ro * wob(a, 0, p) * wobA;
    c.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r);
  }
  c.closePath();
  for (let i = 96; i >= 0; i--) {
    const a = i / 96 * TAU, r = ri * wob(a, 1, p) * wobB;
    if (i === 96) c.moveTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r);
    else c.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r);
  }
  c.closePath();
}

export function drawCrossSection(c, { x, y, R, press = 0, alpha = 1 }) {
  if (alpha <= .01) return;
  const p = press;
  // lumen distends; the wall layers thin while the outer serosal line stays put
  const rLum = R * (.285 + .065 * p);
  const rMuc = rLum + R * (.155 - .012 * p);
  const rSub = rMuc + R * (.165 - .004 * p);
  const rMus = rSub + R * (.285 - .050 * p);
  const rSer = R * (.995 + .005 * p);

  c.save();
  c.globalAlpha *= alpha;
  c.translate(x, y);
  c.rotate(-.12);
  c.scale(1.14, .88);

  // soft cast shadow on paper
  const sh = c.createRadialGradient(4, 8, R * .4, 4, 8, R * 1.06);
  sh.addColorStop(0, 'rgba(90,60,66,.10)');
  sh.addColorStop(1, 'rgba(90,60,66,0)');
  c.fillStyle = sh;
  c.beginPath(); c.arc(4, 8, R * 1.06, 0, TAU); c.fill();

  // serosa / subserosa
  ring(c, 0, 0, rSer, rMus, 1, 1, p);
  c.fillStyle = '#E9CFD2'; c.fill();
  c.strokeStyle = 'rgba(150,104,116,.55)'; c.lineWidth = 2; c.stroke();

  // muscularis — congested, watercolour mottling
  ring(c, 0, 0, rMus, rSub, 1, 1, p);
  const mg = c.createRadialGradient(-R * .3, -R * .35, R * .2, 0, 0, rMus);
  mg.addColorStop(0, '#C06A66');
  mg.addColorStop(.55, '#AE4F52');
  mg.addColorStop(1, '#8E3A42');
  c.fillStyle = mg; c.fill();
  c.save(); c.clip();
  const tex = get('mech.cross');
  if (tex) { c.globalAlpha *= .42; c.drawImage(tex, -rMus, -rMus, rMus * 2, rMus * 2); }
  c.restore();
  c.strokeStyle = 'rgba(110,52,60,.55)'; c.lineWidth = 2; c.stroke();

  // submucosa
  ring(c, 0, 0, rSub, rMuc, 1, 1, p);
  c.fillStyle = '#E7D2CC'; c.fill();
  c.strokeStyle = 'rgba(150,104,116,.42)'; c.lineWidth = 1.6; c.stroke();

  // mucosa — irregular folds
  c.beginPath();
  for (let i = 0; i <= 120; i++) {
    const a = i / 120 * TAU;
    const r = rMuc * (1 + .045 * Math.sin(a * 11 + .7 + p * 2) + .02 * Math.sin(a * 19));
    c.lineTo(Math.cos(a) * r, Math.sin(a) * r);
  }
  c.closePath();
  for (let i = 120; i >= 0; i--) {
    const a = i / 120 * TAU;
    const r = rLum * (1 + .035 * Math.sin(a * 9 + 1.5));
    if (i === 120) c.moveTo(Math.cos(a) * r, Math.sin(a) * r);
    else c.lineTo(Math.cos(a) * r, Math.sin(a) * r);
  }
  c.closePath();
  c.fillStyle = '#C98390'; c.fill();
  c.strokeStyle = 'rgba(120,58,74,.45)'; c.lineWidth = 1.5; c.stroke();

  // lumen: murky residual content (yellowish, not a bright stain)
  c.beginPath();
  for (let i = 0; i <= 96; i++) {
    const a = i / 96 * TAU;
    const r = rLum * (1 + .035 * Math.sin(a * 9 + 1.5));
    c.lineTo(Math.cos(a) * r, Math.sin(a) * r);
  }
