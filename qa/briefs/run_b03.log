export function createTimeline(script,data) {
 const rows=script.sentences, entries=data.sentences;
 if(!Array.isArray(entries)||entries.length!==77||rows.length!==77)throw Error('Timeline requires 77 sentences');
 const map=new Map();let previous=0;
 entries.forEach((e,i)=>{const id=String(i+1).padStart(2,'0');if(e.id!==id||rows[i].id!==id||e.zh!==rows[i].zh||!Number.isFinite(e.start)||!Number.isFinite(e.end)||e.start<previous||e.start<0||e.end<=e.start||map.has(id))throw Error(`Invalid timeline/text at ${id}`);map.set(id,e);previous=e.end;});
 const get=id=>{if(typeof id!=='string'||!map.has(id))throw Error(`Unknown sentence ID: ${id}`);return map.get(id);};
 return Object.freeze({status:data.status,duration:previous,atId:(id,offset=0)=>get(id).start+offset,endId:(id,offset=0)=>get(id).end+offset,fracId:(id,f)=>{if(!Number.isFinite(f)||f<0||f>1)throw Error('Fraction must be 0..1');const e=get(id);return e.start+(e.end-e.start)*f;},sentenceAt:t=>{if(!Number.isFinite(t))throw Error('Invalid render time');return entries.find(e=>t>=e.start&&t<e.end)||entries[t<0?0:76];}});
}
export async function loadTimeline(script,url='./data/timeline.preview.json') { const r=await fetch(url);if(!r.ok)throw Error(`Timeline fetch failed: ${url}`);return createTimeline(script,await r.json()); }
# b02 风格与病理自检

结论：CPU 后端工程检查通过；已打开用户指定的四张参考图，并复看输出的低/中/高倍、病理补充帧与大体帧。Chromium 正式验收仍交 mini 执行 `node render.mjs --samples`。CPU 的 p5.brush shim 不等于浏览器实际水彩，不能据 CPU 图宣称 Chromium 的水彩颗粒已通过。

## 风格规范第 7 节，逐条记录

| 条目 | 结果与证据 |
|---|---|
| 1 结构线与排线 | 通过。14 个旧库逐字节相等；Rough 默认 2.6 / .9 / .8。大体沿用该默认，隐窝只用细线覆盖值 1.4 / .55。镜下用组织纤维，不调用人物 hatch；镜下关闭 boil 和 alive。 |
| 2 中性粒 2–5 叶 | CPU 通过。调用未经修改的 `he_detail.detailedNeutrophil`，保留胞质缝、核桥、染色质团及颗粒；高倍/真 2× 缺损局部可检查。叶数分布沿用规范概率；没有用紫色团块代替细胞。 |
| 3 细胞密度与坏死区 | CPU 通过。S08 中倍主样帧实际圆内179 个中性粒（完整横断面低倍总数不能与局部高倍直接比较），肌层全张仅五个，浆膜零个。S10 增加全层与腔内细胞，部分固缩碎裂；S13/S14 坏死核心调用旧库影细胞/碎屑并关闭核心完好浸润细胞，活细胞保留在病灶外周。计数仅作离屏 QA，不上屏。最终具体数值见 render-check.json 的 sceneMetrics。 |
| 4 RBC、比例、血管与血栓 | CPU 通过。RBC 基准 rx=5，双凹淡区及细边；中性粒胞质按原版尺寸约为 RBC 直径 1.5 倍。小血管调用旧双层壁与内皮核，追加充盈 RBC；S08 不画血栓。S13/S14 调用旧 `gangrene` 的 Zahn 红/粉分层血栓。 |
| 5 纤维素粗丝和细网 | CPU 通过。S10 浆膜渗出裁取旧 ch04 纤维素带，同时保留粗丝与 `fibrinMesh` 细网；S13/S14 的旧 ch04 同时含 60 条粗丝与 140 条细网，57 句裂隙采用旧粗/细裂隙纤维素。S08 无纤维素性渗出，不误加网。 |
| 6 色板与纸色 | 通过。HE 核紫、胞质伊红粉，组织不随情绪改色；目镜外 #111114。背景只由原版 moodAt.paper + 原版 grid 绘制。大体脓苔 #CDB98A，黄图例用规范 #B39459，明显区别纸色；远端局部暗黑，余部暗红。 |
| 7 水彩烘焙与拉伸 | 工程通过，Chromium 观感待验。旧 wash 保持原样，适配层均 hd:true、soft:true、grain:.12、edge:.3、bleed:.5，2048 输出。S08 最大单笔屏幕跨度 900×2.15=1935 <2048；S13/S14 高倍按旧贴图尺寸约束至 1.5，含纵向 1.3 几何映射后 1024×1.5×1.3≈1997 <2048。刷子按每次 bake 的 scale 倒数还原。真 2× 局部是重新执行场景绘制，见 crop-metadata.json，未把 1080p 裁片放大冒充重绘。 |
| 8 字号、安全区、引线 | CPU 通过。画面与过程卡在 y<950；常规标注在 y<900。中文/英文字幕按用户覆盖规范用 52/30，基线 1010/1052；无字幕底色块，仅纸色描边。标注细引线使用 ann.leader 1.6，短标签，500/700 字重。过程卡离关键结构与层名，按句淡入淡出。 |
| 9 节拍和交接 | 通过。低中高倍、平移站点、标题退场、穿孔均由 atId/fracId/endId 驱动；camera.camAt 连续缓动，站点间停留。main 交接先重画上一场 endId(to)−0.001 的末态，再在本场首句前 8% 内过渡。预览音轨仍用 timeline.preview，正式配音对齐后沿同一 ID 接入。 |
| 10 确定性与数字出处 | CPU 通过。63 个时间点正序/逆序、fresh page，以及 77 句布局状态通过；关键帧另做独立进程 SHA-256 比较。没有新增上屏计数、比例尺、具体物镜倍率或患者数据。倍率仅“低倍 / 中倍 / 高倍”。 |
| 11 正常阑尾参照 | CPU 通过。S08 保留管状隐窝、柱状上皮和杯状细胞；淋巴滤泡深染套区/浅染生发中心；补薄黏膜肌层；内环圆核/外纵梭核、双层分界；浆膜扁平间皮。层宽不等，黏膜下宽，肌层厚于黏膜。详见病理结构依据_b02.md。 |

## 本轮附加验收

- S01：三根并列，红轻肿、黄明显肿胀且有灰黄脓苔、黑维持黄的体积并仅远端暗黑；无背后淡黄色虚影。片名于开场后退出。英文卡拼回完整文本显示。
- S08：六张指定状态图齐全；高倍按句子从固有层移至血管、肌层、浆膜，34 句停上皮缺损。英文为 `Focal mucosal epithelial injury and shedding.`。
- S10 / S14 / S19：复用同一 microscope_zoom，补充低中高样帧；S13 同用该模块呈现血栓和坏死。镜下无装饰晃动，无组织自身变形；对焦使用旧目镜风格的轻淡雾，不用可能让 WebGL 水彩丢失的 blur filter，高倍平移不失焦。
- S19：小圆深染核淋巴细胞与偏位车辐核、核旁淡区浆细胞可区分；以纤维化和慢性炎细胞为主。
- 必交文件：s01_key.png、s08_key.png、s08_low.png、s08_mid.png、s08_high.png、s08_zoom_transition.png、s08_high_pan.png、s08_high_defect.png、两张 `_200.png`、s08_phone_390pt.png、对比_ref04_vs_s08.png。
- 手机图为 390×844 竖屏中完整横版视频的等比模拟，没有改成竖版排版；缩小后字幕约 10.6/6.1 像素，只作实际观看尺寸检查，不能宣称手机可读性等同 1080p。
- 未写 v4_mix 或 assembly，未 git commit。Grok Bot 正式字幕尚未接入，当前占位组件保持约定尺寸和基线。
