 if n=='finalize.sh':s=s.replace('python3 qa/v6/e10_s19/detail_review.py','python3 qa/v6/e10_s19/count_review.py')
 if n=='make_bundle.py':s=s.replace(\"files=['film/lib_ext/he_chronic.js']\",\"files=['film/lib_ext/he_chronic.js','film/chapters/s19.js']\")
 (p/n).write_text(s)
f=Path('film/lib_ext/he_chronic.js');s=f.read_text()
s=s.replace(\"pl?.05:.11\",\"pl?.05:.018\").replace('ny,.085,24','ny,.018,72')
s=s.replace(\"'#985B8C'\",\"'#8C467E'\").replace(\"'#AA6C9B'\",\"'#9C568E'\").replace(\"'#BC87AA'\",\"'#AD709B'\")
s=s.replace('[[-9,5,.4],[8,8,-.8],[7,-8,.7]]','[[-5,4,.4],[4.5,4,-.8],[4,-4.5,.7]]')
s=s.replace('field(focus.lymph,220,330);','field(focus.lymph,220,700);')
s=s.replace('for(let i=0;i<80;i++)add','for(let i=0;i<260;i++)add')
s=s.replace('return {...q,s:Math.max(q.s,1+1.65*w)};',\"const dl=Math.hypot(q.x-focus.lymph[0],q.y-focus.lymph[1]);const wl=Math.min(1,Math.max(0,(dl-75)/30));return {...q,s:Math.max(q.s,1+1.65*w*wl)};\")
