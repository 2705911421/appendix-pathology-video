 q=d[k];e=q.get('relative_error');rows.append('|'+k+'|'+str(q['counts']['small'])+'|'+str(q['counts']['spindle'])+'|'+('参照' if not e else f\"{e['small']:+.1%} / {e['spindle']:+.1%}\")+'|')
