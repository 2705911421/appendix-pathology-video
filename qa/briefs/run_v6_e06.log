 a=np.array(Image.open(path).convert('RGB').crop(box)).astype(float);m=(a[:,:,2]>a[:,:,0]*1.1)&(a[:,:,0]<135)&(a[:,:,1]<110);found=[]
 for y,x in zip(*np.where(m)):
  if not m[y,x]:continue
