  ],
  "pairs": [
    {
      "n": 1,
      "cue_index": 1,
      "timeline_text": "这根形似小香肠的盲管，就是阑尾。",
      "srt_text": "午饭后，你的肚脐周围开始隐隐作痛。",
      "text_match": false,
      "timeline_start": 0.0,
      "timeline_end": 4.120916666666667,
      "srt_start": 0.0,
      "srt_end": 3.8,
      "delta_start": 0.0,
      "delta_end": -0.3209166666666672,
      "pass": false
    },
    {
      "n": 2,
      "cue_index": 2,
      "timeline_text": "发起炎来，它可能染上红、黄、黑。",
      "srt_text": "起初你以为只是吃坏了肚子，忍忍就过去了。",
      "text_match": false,
      "timeline_start": 4.570916666666667,
      "timeline_end": 7.951041666666667,
      "srt_start": 4.3,
      "srt_end": 8.5,
      "delta_start": -0.27091666666666736,
      "delta_end": 0.5489583333333332,
      "pass": false
    },
    {
      "n": 3,
      "cue_index": 3,
      "timeline_text": "每一次颜色流转，都记录着组织的伤痕。",
      "srt_text": "可到了半夜，这股疼突然“搬了家”——死死钉在右下腹，连咳嗽、按压都像针扎，体温也飙了上去。",
      "text_match": false,
      "timeline_start": 8.401041666666666,
      "timeline_end": 12.328416666666666,
      "srt_start": 9.0,
      "srt_end": 19.8,
      "delta_start": 0.5989583333333339,
      "delta_end": 7.471583333333335,
      "pass": false
    },
    {
      "n": 4,
      "cue_index": 4,
      "timeline_text": "循着这抹色彩，我们走进炎症的现场。",
      "srt_text": "急诊室里，医生敲定诊断：急性阑尾炎。",
      "text_match": false,
      "timeline_start": 12.778416666666665,
      "timeline_end": 16.450874999999996,
      "srt_start": 20.3,
      "srt_end": 24.0,
      "delta_start": 7.521583333333336,
      "delta_end": 7.549125000000004,
      "pass": false
    },
    {
      "n": 5,
      "cue_index": 5,
      "timeline_text": "病理学里的“变质”，不是食物变坏。",
      "srt_text": "切下来的这根阑尾，早已不是平时粉白细长的模样。",
      "text_match": false,
      "timeline_start": 16.900874999999996,
      "timeline_end": 20.86695833333333,
      "srt_start": 24.8,
      "srt_end": 29.9,
      "delta_start": 7.899125000000005,
      "delta_end": 9.03304166666667,
      "pass": false
    },
    {
      "n": 6,
      "cue_index": 6,
      "timeline_text": "先听听身体发出的求救信号。",
      "srt_text": "它肿得像根暗红色的香肠，表面糊着一层灰黄色的脓苔，切开管腔，里面更是积满了浑浊的脓液。",
      "text_match": false,
      "timeline_start": 21.66695833333333,
      "timeline_end": 24.11283333333333,
      "srt_start": 30.3,
      "srt_end": 39.7,
      "delta_start": 8.63304166666667,
      "delta_end": 15.587166666666672,
      "pass": false
    },
    {
      "n": 7,
      "cue_index": 7,
      "timeline_text": "疼痛可能从肚脐周围，移向右下腹。",
      "srt_text": "这短短几小时里，你的右下腹究竟经历了什么？",
      "text_match": false,
      "timeline_start": 24.56283333333333,
      "timeline_end": 28.749291666666664,
      "srt_start": 40.3,
      "srt_end": 45.1,
      "delta_start": 15.737166666666667,
      "delta_end": 16.350708333333337,
      "pass": false
    },
    {
      "n": 8,
      "cue_index": 8,
      "timeline_text": "还可能恶心、发热，右下腹明显压痛。",
      "srt_text": "把切片推到显微镜下，“案发现场”才真正显露：",
      "text_match": false,
      "timeline_start": 29.199291666666664,
      "timeline_end": 33.38045833333333,
      "srt_start": 45.9,
      "srt_end": 50.3,
      "delta_start": 16.700708333333335,
      "delta_end": 16.919541666666667,
      "pass": false
    },
    {
      "n": 9,
      "cue_index": 9,
      "timeline_text": "疼痛若持续加重，别抱着侥幸硬扛。",
      "srt_text": "阑尾黏膜已经破溃缺损，成千上万的中性粒细胞像急行军一样，弥漫浸润了整层阑尾壁，连最外层的浆膜都在往外渗出纤维素。",
      "text_match": false,
      "timeline_start": 33.83045833333333,
      "timeline_end": 37.84191666666666,
      "srt_start": 50.8,
      "srt_end": 63.6,
      "delta_start": 16.969541666666665,
      "delta_end": 25.75808333333334,
      "pass": false
    },
    {
      "n": 10,
      "cue_index": 10,
      "timeline_text": "相似的求救声，也可能来自其他腹部疾病。",
      "srt_text": "病理医生会写下一行精准的判决：急性蜂窝织炎性阑尾炎——也就是典型的化脓性炎。",
      "text_match": false,
      "timeline_start": 38.291916666666665,
      "timeline_end": 42.61395833333333,
      "srt_start": 64.0,
      "srt_end": 72.2,
      "delta_start": 25.708083333333335,
      "delta_end": 29.586041666666674,
      "pass": false
    },
    {
      "n": 11,
      "cue_index": 11,
      "timeline_text": "有些人的信号，却并不典型。",
      "srt_text": "其实，在这根盲管里，战火是一步步升级的：",
      "text_match": false,
      "timeline_start": 43.06395833333333,
      "timeline_end": 45.93691666666667,
      "srt_start": 73.0,
      "srt_end": 77.4,
      "delta_start": 29.936041666666668,
      "delta_end": 31.463083333333337,
      "pass": false
    },
    {
      "n": 12,
      "cue_index": 12,
      "timeline_text": "医生先循着症状和体格检查寻找线索，",
      "srt_text": "如果战火只局限在黏膜及黏膜下层，还只是温和的单纯性阑尾炎；",
      "text_match": false,
      "timeline_start": 46.38691666666667,
      "timeline_end": 49.68708333333334,
      "srt_start": 77.8,
      "srt_end": 84.1,
      "delta_start": 31.413083333333326,
      "delta_end": 34.41291666666665,
      "pass": false
    },
    {
      "n": 13,
      "cue_index": 13,
      "timeline_text": "再参考化验，判断是否阑尾炎。",
      "srt_text": "一旦蔓延全层、化脓积液，就升级成了刚才的蜂窝织炎性；",
      "text_match": false,
      "timeline_start": 50.137083333333344,
      "timeline_end": 53.45083333333334,
      "srt_start": 84.6,
      "srt_end": 90.3,
      "delta_start": 34.46291666666665,
      "delta_end": 36.849166666666655,
      "pass": false
    },
    {
      "n": 14,
      "cue_index": 14,
      "timeline_text": "CT是重要的辅助确诊工具，",
      "srt_text": "要是再拖下去，血管被压迫堵死，整根阑尾发黑坏死、甚至穿孔破裂，就会沦为凶险的坏疽性阑尾炎。",
      "text_match": false,
      "timeline_start": 53.900833333333345,
      "timeline_end": 56.50666666666668,
      "srt_start": 90.8,
      "srt_end": 101.6,
      "delta_start": 36.89916666666665,
      "delta_end": 45.09333333333331,
      "pass": false
    },
    {
      "n": 15,
      "cue_index": 15,
      "timeline_text": "但并非人人都必须做CT。",
      "srt_text": "看到这儿你可能会问：把阑尾折腾成这样的“炎症”，到底是个什么东西？",
      "text_match": false,
      "timeline_start": 56.956666666666685,
      "timeline_end": 59.335875000000016,
      "srt_start": 102.4,
      "srt_end": 108.0,
      "delta_start": 45.44333333333332,
      "delta_end": 48.664124999999984,
      "pass": false
    },
    {
      "n": 16,
      "cue_index": 16,
      "timeline_text": "汇总8项研究的荟萃分析显示，",
      "srt_text": "记住一句话：炎症不是“生病”本身，而是身体面对损伤和感染时，主动打响的自卫反击战。",
      "text_match": false,
      "timeline_start": 59.78587500000002,
      "timeline_end": 62.476791666666685,
      "srt_start": 108.5,
      "srt_end": 117.7,
      "delta_start": 48.71412499999998,
      "delta_end": 55.22320833333332,
      "pass": false
    },
    {
      "n": 17,
      "cue_index": 17,
      "timeline_text": "增强螺旋CT敏感度95%、特异度94%。[1]",
      "srt_text": "为了把免疫大军运上前线，局部血管先扩张充血——于是这里变红、发热；",
      "text_match": false,
      "timeline_start": 62.92679166666669,
      "timeline_end": 69.00687500000002,
      "srt_start": 118.2,
      "srt_end": 125.8,
      "delta_start": 55.273208333333315,
      "delta_end": 56.793124999999975,
      "pass": false
    },
    {
      "n": 18,
      "cue_index": 18,
      "timeline_text": "这束影像之光，能帮助发现病变，",
      "srt_text": "接着，富含蛋白质的血浆和白细胞挤出血管——组织开始水肿；",
      "text_match": false,
      "timeline_start": 69.45687500000003,
      "timeline_end": 72.73883333333336,
      "srt_start": 126.2,
      "srt_end": 132.2,
      "delta_start": 56.74312499999998,
      "delta_end": 59.46116666666663,
      "pass": false
    },
    {
      "n": 19,
      "cue_index": 19,
      "timeline_text": "却仍需结合临床，判断病情轻重。",
      "srt_text": "渗出物撑胀管壁，加上炎症因子刺激神经——引发剧烈疼痛；",
      "text_match": false,
      "timeline_start": 73.18883333333336,
      "timeline_end": 77.1246666666667,
      "srt_start": 132.6,
      "srt_end": 138.6,
      "delta_start": 59.41116666666663,
      "delta_end": 61.475333333333296,
      "pass": false
    },
    {
      "n": 20,
      "cue_index": 20,
      "timeline_text": "单纯性→化脓性（蜂窝织炎性）→坏疽性",
      "srt_text": "最终，受损的组织无法正常工作——导致功能障碍。",
      "text_match": false,
      "timeline_start": 77.9246666666667,
      "timeline_end": 82.76412500000004,
      "srt_start": 139.0,
      "srt_end": 144.7,
      "delta_start": 61.075333333333305,
      "delta_end": 61.93587499999995,
      "pass": false
    },
    {
      "n": 21,
      "cue_index": 21,
      "timeline_text": "是最常见的典型演变，",
      "srt_text": "而在病理学家眼里，这场战斗始终交织着三种基本动作：",
      "text_match": false,
      "timeline_start": 83.01412500000004,
      "timeline_end": 85.70245833333337,
      "srt_start": 145.1,
      "srt_end": 150.4,
      "delta_start": 62.08587499999996,
      "delta_end": 64.69754166666664,
      "pass": false
    },
    {
      "n": 22,
      "cue_index": 22,
      "timeline_text": "但并不是每个患者都必经的固定流程。",
      "srt_text": "阑尾壁细胞受损坏死，叫变质，是战场的战损；",
      "text_match": false,
      "timeline_start": 85.95245833333337,
      "timeline_end": 89.83675000000004,
      "srt_start": 150.9,
      "srt_end": 156.2,
      "delta_start": 64.94754166666664,
      "delta_end": 66.36324999999995,
      "pass": false
    },
    {
      "n": 23,
      "cue_index": 23,
      "timeline_text": "第一幕红：单纯性阑尾炎，充血、轻度肿胀。",
      "srt_text": "白细胞和脓液涌出血管，叫渗出，是主力的冲锋；",
      "text_match": false,
      "timeline_start": 90.63675000000003,
      "timeline_end": 96.17233333333337,
      "srt_start": 156.6,
      "srt_end": 161.9,
      "delta_start": 65.96324999999996,
      "delta_end": 65.72766666666664,
      "pass": false
    },
    {
      "n": 24,
      "cue_index": 24,
      "timeline_text": "局部血管扩张，血流增多，染出这抹红。",
      "srt_text": "后期纤维组织长出、填补创面，叫增生，是战后的重建。",
      "text_match": false,
      "timeline_start": 96.62233333333337,
      "timeline_end": 100.77237500000004,
      "srt_start": 162.4,
      "srt_end": 168.4,
      "delta_start": 65.77766666666663,
      "delta_end": 67.62762499999997,
      "pass": false
    },
    {
      "n": 25,
      "cue_index": 25,
      "timeline_text": "血管里的液体和蛋白质渗出，",
      "srt_text": "当局部战事吃紧，你的身体还会拉响全身警报——发烧、血常规里白细胞飙升，都是免疫系统在紧急调兵遣将。",
      "text_match": false,
      "timeline_start": 101.22237500000004,
      "timeline_end": 103.65625000000004,
      "srt_start": 169.2,
      "srt_end": 180.1,
      "delta_start": 67.97762499999995,
      "delta_end": 76.44374999999995,
      "pass": false
    },
    {
      "n": 26,
      "cue_index": 26,
      "timeline_text": "积在组织间隙，形成水肿。",
      "srt_text": "大多数时候，只要防线稳固，炎症都能顺利消退、彻底痊愈；",
      "text_match": false,
      "timeline_start": 104.10625000000005,
      "timeline_end": 107.33079166666671,
      "srt_start": 180.6,
      "srt_end": 187.1,
      "delta_start": 76.49374999999995,
      "delta_end": 79.76920833333328,
      "pass": false
    },
    {
      "n": 27,
      "cue_index": 27,
      "timeline_text": "巡逻的白细胞游出血管，挺进受损组织。",
      "srt_text": "但如果致炎因子迟迟除不掉，就会拉锯成慢性炎症；",
      "text_match": false,
      "timeline_start": 107.78079166666672,
      "timeline_end": 111.99695833333338,
      "srt_start": 187.6,
      "srt_end": 192.2,
      "delta_start": 79.81920833333328,
      "delta_end": 80.2030416666666,
      "pass": false
    },
    {
      "n": 28,
      "cue_index": 28,
      "timeline_text": "这是身体为抵御损伤，调动的防御。",
      "srt_text": "一旦防线崩溃，感染便会四处蔓延——比如阑尾穿孔，脓液涌入腹腔，演变成可能危及生命的弥漫性腹膜炎。",
      "text_match": false,
      "timeline_start": 112.44695833333338,
      "timeline_end": 116.16454166666672,
      "srt_start": 192.6,
      "srt_end": 203.6,
      "delta_start": 80.15304166666661,
      "delta_end": 87.43545833333327,
      "pass": false
    },
    {
      "n": 29,
      "cue_index": 29,
      "timeline_text": "然而战况一旦失控，也可能伤及自身组织。",
      "srt_text": "所以你看，炎症本身不是敌人，失控的炎症才是。",
      "text_match": false,
      "timeline_start": 116.61454166666672,
      "timeline_end": 120.71216666666672,
      "srt_start": 204.4,
      "srt_end": 209.9,
      "delta_start": 87.78545833333328,
      "delta_end": 89.18783333333329,
      "pass": false
    },
    {
      "n": 30,
      "cue_index": 30,
      "timeline_text": "液体、蛋白质和白细胞外出，叫渗出。",
      "srt_text": "更重要的是，发炎不等于细菌感染——扭伤、过敏、痛风同样会发炎；一发炎就自己找抗生素吃，往往既不对症，还可能掩盖病情。",
      "text_match": false,
      "timeline_start": 121.16216666666672,
      "timeline_end": 125.55695833333338,
      "srt_start": 210.3,
      "srt_end": 224.0,
      "delta_start": 89.13783333333329,
      "delta_end": 98.44304166666662,
      "pass": false
    },
    {
      "n": 31,
      "cue_index": 31,
      "timeline_text": "单纯性时，中性粒细胞主要驻守在",
      "srt_text": "读懂这一根阑尾，就读懂了炎症最基本的规律。",
      "text_match": false,
      "timeline_start": 126.00695833333339,
      "timeline_end": 130.09441666666672,
      "srt_start": 224.5,
      "srt_end": 229.9,
      "delta_start": 98.49304166666661,
      "delta_end": 99.80558333333329,
      "pass": false
    },
    {
      "n": 32,
      "cue_index": 32,
      "timeline_text": "黏膜及黏膜下层，组织损伤相对较轻。",
      "srt_text": "下次遇到转移性右下腹痛、发热拒按，别硬扛——早一点交给医生，就是给身体这场保卫战，最好的支援。",
      "text_match": false,
      "timeline_start": 130.5444166666667,
      "timeline_end": 134.93608333333339,
      "srt_start": 230.3,
      "srt_end": 239.3,
      "delta_start": 99.7555833333333,
      "delta_end": 104.36391666666663,
      "pass": false
    }
  ]
}
